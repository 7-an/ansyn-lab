<dialog class="page-transition" data-page-transition aria-labelledby="page-transition-label" data-preserve-language data-lenis-prevent>
  <div class="page-transition-screen" aria-hidden="true">
    <div class="page-transition-curve is-top"><i></i></div>
    <div class="page-transition-curve is-bottom"><i></i></div>
  </div>
  <p id="page-transition-label" class="page-transition-label"><span aria-hidden="true"></span><span data-transition-label></span></p>
</dialog>
<script is:inline>
  // Populate the handoff before the first paint, even while modules are loading.
  const transitionLabel = document.querySelector('[data-transition-label]');
  if (transitionLabel) transitionLabel.textContent = document.documentElement.dataset.transitionTitle || '';
</script>
<script>import "../lib/page-transition";</script>
<style is:global>
  .page-transition { position: fixed; inset: 0; z-index: 1000; margin: 0; padding: 0; border: 0; width: 100%; height: 100dvh; max-width: none; max-height: none; overflow: hidden; background: transparent; color: #fdfdfd; overscroll-behavior: none; }
  .page-transition:not([open]) { display: none; }
  .page-transition[open], html[data-transition-incoming] .page-transition { display: block; }
  .page-transition::backdrop { background: transparent; }
  .page-transition-screen { position: absolute; inset: 0; background: #0f0f0f; transform: translateY(110%); will-change: transform; }
  .page-transition-curve { position: absolute; left: 0; width: 100%; height: 0; overflow: hidden; }
  .page-transition-curve i { position: absolute; display: block; left: 50%; width: 150%; height: 745%; border-radius: 50%; background: #0f0f0f; transform: translate(-50%, -86.58%); }
  .page-transition-curve.is-top { top: 1px; transform: translateY(-100%) scaleY(-1); }
  .page-transition-curve.is-bottom { bottom: 1px; transform: translateY(100%); height: 10vh; }
  .page-transition-label { position: absolute; top: calc(50% - 50px); left: 50%; margin: 0; transform: translate(-50%, -50%); display: flex; align-items: center; gap: .5em; white-space: nowrap; color: #fdfdfd; font: 400 clamp(36px, 5vw, 68px)/1.2 "Helvetica Neue", Arial, sans-serif; letter-spacing: -.025em; opacity: 0; }
  .page-transition-label > span:first-child { flex: 0 0 auto; width: .16em; height: .16em; border-radius: 50%; background: currentColor; }
  html[data-transition-incoming] .page-transition-screen { transform: translateY(0); }
  html[data-transition-incoming] .page-transition-label { opacity: 1; }
  html[data-page-transitioning] { cursor: wait; }
  html[data-opening-intro] { overflow: hidden; }
  html[data-opening-intro] .page-transition-label { opacity: 0; }
  html[data-opening-intro] .hero-word .strip,
  html[data-opening-intro] .hero-scanline::after,
  html[data-opening-intro] .text-overprint { animation-play-state: paused !important; }
  @media (max-width: 540px) { .page-transition-curve.is-bottom { height: 5vh; } .page-transition-label { top: calc(50% - 30px); } }
  @media (prefers-reduced-motion: reduce) { html[data-transition-incoming] .page-transition { display: none; } }
</style>
