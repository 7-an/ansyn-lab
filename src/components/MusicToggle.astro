<div class="music-control" data-music-control>
  <audio data-site-audio src="/audio/ansyn-theme.mp3" preload="none" loop></audio>
  <button
    class="music-toggle"
    type="button"
    aria-pressed="false"
    aria-label="播放背景音乐"
    title="背景音乐开关"
  >
    <span class="music-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" role="presentation">
        <path class="music-speaker" d="M5 9.2h3.2L12.7 5v14l-4.5-4.2H5z" />
        <path class="music-wave music-wave-one" d="M15.4 9.1c.8.7 1.2 1.7 1.2 2.9s-.4 2.2-1.2 2.9" />
        <path class="music-wave music-wave-two" d="M18 6.7c1.4 1.4 2.1 3.1 2.1 5.3s-.7 3.9-2.1 5.3" />
        <path class="music-slash" d="M4.5 4.5l15 15" />
      </svg>
    </span>
    <span class="music-label" data-music-label>SOUND OFF</span>
  </button>
</div>

<script>
  const musicControl = document.querySelector<HTMLElement>("[data-music-control]");
  const musicButton = musicControl?.querySelector<HTMLButtonElement>(".music-toggle");
  const musicLabel = musicControl?.querySelector<HTMLElement>("[data-music-label]");
  const siteAudio = musicControl?.querySelector<HTMLAudioElement>("[data-site-audio]");

  if (musicControl && musicButton && musicLabel && siteAudio) {
    const preferenceKey = "ansyn-music-enabled";
    const timeKey = "ansyn-music-time";
    siteAudio.volume = .46;
    let musicEnabled = true;
    let unlockArmed = false;

    const readSession = (key: string) => {
      try { return window.sessionStorage.getItem(key); }
      catch { return null; }
    };

    const writeSession = (key: string, value: string) => {
      try { window.sessionStorage.setItem(key, value); }
      catch { /* The control still works when storage is unavailable. */ }
    };

    const renderPreference = () => {
      musicControl.classList.toggle("is-enabled", musicEnabled);
      musicButton.setAttribute("aria-pressed", String(musicEnabled));
      musicButton.setAttribute("aria-label", musicEnabled ? "关闭背景音乐" : "播放背景音乐");
      musicButton.title = musicEnabled ? "关闭背景音乐" : "播放背景音乐";
      musicLabel.textContent = musicEnabled ? "SOUND ON" : "SOUND OFF";
    };

    const renderPlayback = (playing: boolean) => {
      musicControl.classList.toggle("is-playing", playing);
    };

    const unlockPlayback = () => {
      if (!musicEnabled || !siteAudio.paused) return;
      void playMusic();
    };

    const armPlaybackUnlock = () => {
      if (unlockArmed) return;
      unlockArmed = true;
      document.addEventListener("pointerdown", unlockPlayback, { once: true });
      document.addEventListener("keydown", unlockPlayback, { once: true });
    };

    const playMusic = async () => {
      if (!musicEnabled) return;
      try {
        await siteAudio.play();
        writeSession(preferenceKey, "on");
      } catch {
        renderPlayback(false);
        armPlaybackUnlock();
      }
    };

    musicButton.addEventListener("click", () => {
      if (musicEnabled) {
        musicEnabled = false;
        siteAudio.pause();
        writeSession(preferenceKey, "off");
      } else {
        musicEnabled = true;
        writeSession(preferenceKey, "on");
        void playMusic();
      }
      renderPreference();
    });

    siteAudio.addEventListener("play", () => renderPlayback(true));
    siteAudio.addEventListener("pause", () => renderPlayback(false));
    siteAudio.addEventListener("loadedmetadata", () => {
      const savedTime = Number(readSession(timeKey));
      if (Number.isFinite(savedTime) && savedTime > 0 && savedTime < siteAudio.duration) {
        siteAudio.currentTime = savedTime;
      }
    });

    window.addEventListener("pagehide", () => {
      writeSession(timeKey, String(siteAudio.currentTime));
    });

    musicEnabled = readSession(preferenceKey) !== "off";
    renderPreference();
    renderPlayback(false);
    if (musicEnabled) void playMusic();
  }
</script>
