---
import { globeLocations } from "../config/globe-locations";
import { siteConfig } from "../config/site";
import Header from "./Header.astro";
---

    <a class="skip" href="#current">Skip to current chapter</a>
    <Header home />
      <section class="journey" data-journey aria-labelledby="journey-title">
        <span class="current-anchor" data-screen-stop id="current" aria-hidden="true"></span>
        <div class="stage" data-stage>
          <div class="opening" data-opening>
            <canvas class="text-field" data-field aria-hidden="true"></canvas>
            <div class="hero-scanline" aria-hidden="true"></div>
            <div class="static-name" aria-hidden="true">ANSYN</div>
            <h1 id="journey-title" class="sr-only">Ansyn: born in 2007, exploring life beyond school through personal experiments with AI</h1>
            <div class="hero-words" aria-hidden="true">
      <span class="hero-word word-ai">Proof</span>
      <span class="hero-word word-experiment">Motion</span>
      <span class="hero-word word-beta">Signal</span>
      <span class="hero-word word-world">Build</span>
      <span class="hero-word word-07">System</span>
    </div>
            <canvas class="text-overprint" data-field-overprint aria-hidden="true"></canvas>
            <span class="hero-clock" data-hero-clock aria-hidden="true">LOCAL --:--</span>
            <div class="hero-meta"><span class="hero-meta-center">From high school → real world</span><a class="hero-scroll" href="#current">Scroll ↓</a></div>
          </div>
          <canvas class="earth" data-earth aria-hidden="true"></canvas>
          <div class="globe-input" data-globe-input role="img" tabindex="-1" aria-label="Interactive globe: hover or touch for coordinates; drag within the globe or use the arrow keys to rotate"></div>
          <div class="world-copy" data-world-copy>
            <div class="world-title"><h2 class="world-title-en" lang="en" aria-label="An ongoing experiment in the real world"><span class="title-line" aria-hidden="true"><span>An</span> <span>ongoing</span></span><span class="title-line" aria-hidden="true">experiment</span><span class="title-line" aria-hidden="true"><span>in</span> <span>the</span> <span>real</span></span><span class="title-line" aria-hidden="true">world</span></h2><h2 class="world-title-zh" lang="zh-CN"><span>一场持续进行的</span><span>真实世界</span><span>实验</span></h2></div>
            <div class="world-time"><span>LOCAL TIME: <b data-world-clock>--:--:--</b></span><span>TIME ZONE: <b>UTC+08:00</b></span></div>
            {globeLocations.map((place, index) => <button class="map-pin" data-pin={index} type="button" aria-label={`Open ${place.name} notes`} aria-expanded="false" aria-controls="place-gallery"><i></i><span>{place.name}</span></button>)}
            <div class="world-intro" data-world-intro><p class="intro-english" lang="en">I’m Ansyn, exploring the world with AI. Learning in public, building something real.</p><a class="world-now" href={siteConfig.kosx.url} target="_blank" rel="noopener noreferrer" lang="en"><span>Now at</span><img src="/kosx-logo-black.png" alt={siteConfig.kosx.name} width="2350" height="397" loading="lazy" decoding="async" /></a><div class="place-index" lang="en" aria-label="Places">{globeLocations.map((place, index) => <button type="button" data-location={index} aria-controls="place-gallery">{place.english}</button>)}</div></div>
            <section class="place-gallery" id="place-gallery" data-gallery hidden aria-labelledby="gallery-title">
              <header><div><span data-gallery-english>Hong Kong</span><h3 id="gallery-title" data-gallery-title>Hong Kong</h3></div><button type="button" data-gallery-close aria-label="Close place notes">×</button></header>
              <div class="photo-deck" data-photo-deck>
                <div class="photo-back back-two" aria-hidden="true"></div><div class="photo-back back-one" aria-hidden="true"></div>
                <div class="photo-front" data-photo-front><img data-gallery-image hidden alt="" /><div class="photo-placeholder" data-photo-placeholder><span data-photo-city>HONG KONG</span><strong>ON THE MAP</strong><span class="place-coordinates" data-place-coordinates></span><small>Photos to come.</small></div></div>
              </div>
              <footer data-photo-footer><span data-photo-count aria-live="polite"></span><div data-photo-controls><button type="button" data-photo-prev aria-label="Previous photo">←</button><button type="button" data-photo-next aria-label="Next photo">→</button></div></footer>
              <div class="gallery-places" aria-label="Choose a place">{globeLocations.map((place, index) => <button type="button" data-location={index} aria-pressed="false">{place.name}</button>)}</div>
            </section>
            <output class="globe-readout" data-readout aria-label="Globe coordinates"><span>LAT <b data-hover-lat>—</b></span><span>LON <b data-hover-lon>—</b></span></output>
            <p class="map-status" data-map-status hidden role="status"></p>
          </div>
        </div>
      </section>
    <script>import "../lib/home-experience"; import "../lib/home-scroll"; import "../lib/home-signal";</script>

<style>
  @font-face { font-family: "Chivo Mono"; src: url("/fonts/chivo-mono-400-latin.woff2") format("woff2"); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: "Chivo Mono"; src: url("/fonts/chivo-mono-500-latin.woff2") format("woff2"); font-weight: 500; font-style: normal; font-display: swap; }
  /* Use an installed original face when available; web embedding awaits a licensed asset. */
  @font-face { font-family: "World Haas"; src: local("Neue Haas Grotesk Text Pro Bold"), local("NHaasGroteskTXPro-75Bd"); font-weight: 700; font-style: normal; font-display: swap; }
  @font-face { font-family: "Space Mono"; src: url("/fonts/spacemono-400-latin.woff2") format("woff2"); font-weight: 400; font-display: swap; }
  :global(html) { background: var(--paper); scroll-behavior: auto; }
  :global(body) { background: var(--paper); color: var(--ink); margin: 0; font-family: var(--sans); }
  :global(*) { box-sizing: border-box; }
  :global(button) { color: inherit; }
  .skip { position: fixed; z-index: 100; top: 10px; left: 20px; padding: 12px; background: var(--paper); transform: translateY(-160%); }
  .skip:focus { transform: none; }
  .journey { position: relative; height: 285svh; }
  .current-anchor { position: absolute; top: calc(100% - 100svh); }
  .stage { position: sticky; top: 0; height: 100svh; overflow: clip; isolation: isolate; }
  .opening { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .text-field { position: absolute; inset: 0; width: 100%; height: 100%; }
  .static-name { position: absolute; top: 37%; left: 4%; font: 800 24vw/1 "Poppins", var(--sans); letter-spacing: -.06em; color: #d6d6d6; }
  :global(.has-field) .static-name { display: none; }
  h1 { margin: 0; font-weight: 400; }
  .earth { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }
  .globe-input { position: absolute; z-index: 1; border-radius: 50%; clip-path: circle(50%); pointer-events: none; touch-action: pan-y; cursor: grab; }
  .world-copy a, .world-copy button { pointer-events: auto; }
  .world-copy { --world-left: max(10.5%, calc(3% + 132px)); position: absolute; inset: 0; z-index: 3; opacity: 0; pointer-events: none; }
  .world-title { position: absolute; left: var(--world-left); top: 4%; width: 43%; }
  .world-title h2 { font-size: clamp(32px, 4.5vw, 74px); line-height: 1.15; letter-spacing: -.06em; font-weight: 500; margin: 0; }
  @media(max-width: 900px) {
    .world-title { top: 14%; }
  }
  @media(max-width: 600px) {
    .journey { height: 260svh; }
    .world-title { left: 6%; }
  }
  @media(prefers-reduced-motion: reduce) {
    .journey { height: auto; } .stage { position: relative; height: 165svh; }
    .opening { height: 80svh; }
    .earth { top: 80svh; height: 85svh; } .world-copy { top: 80svh; height: 85svh; opacity: 1; }
  }
  :global(html[data-reduced]) .journey { height: auto; }
  :global(html[data-reduced]) .stage { position: relative; height: 165svh; }
  :global(html[data-reduced]) .opening { height: 80svh; }
  :global(html[data-reduced]) .earth { top: 80svh; height: 85svh; }
  :global(html[data-reduced]) .world-copy { top: 80svh; height: 85svh; opacity: 1; }
  :global(html:not(.motion-ready)) .world-copy { opacity: 1; }
  :global(html:not(.motion-ready)) .journey { height: auto; }
  :global(html:not(.motion-ready)) .stage { position: relative; height: 180svh; }
  :global(html:not(.motion-ready)) .opening { height: 85svh; }
  :global(html:not(.motion-ready)) .world-copy { top: 90svh; height: 90svh; }
  .hero-words {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  /* 实心细体大字（小字文字场压在它上面） */
  .hero-word {
    position: absolute;
    font-family: "Poppins", var(--sans);
    font-weight: 400;
    line-height: .9;
    letter-spacing: -.01em;
    white-space: nowrap;
    color: var(--ink);
  }

  .word-ai { top: 7%; left: 1.5%; font-size: clamp(5rem, 11vw, 10rem); }
  .word-experiment { top: 30%; left: 26%; font-size: clamp(4.2rem, 9.5vw, 8.6rem); }
  .word-beta { top: 60%; left: 1%; font-size: clamp(4rem, 9vw, 8.2rem); }
  .word-world { top: 48%; right: 4%; font-size: clamp(4rem, 9vw, 8.2rem); }
  .word-07 { top: 76%; left: 47%; font-size: clamp(4.2rem, 9.5vw, 8.6rem); }

  /* 入场：每个词切成水平条，错峰从左揭示（复刻 2xa 的 printer 打印效果） */
  @property --strip-reveal {
    syntax: "<percentage>";
    inherits: false;
    initial-value: -3%;
  }
  :global(.hero-word .sizer) { visibility: hidden; }
  :global(.hero-word .strip) {
    position: absolute;
    inset: 0;
    clip-path: inset(var(--st, 0%) var(--strip-reveal) var(--sb, 0%) -3%);
  }
  :global(.js:not([data-reduced]) .hero-word .strip) {
    --strip-reveal: 103%;
    animation: strip-in .8s cubic-bezier(.22, 1, .36, 1) forwards;
    animation-delay: calc(var(--wd, 0s) + var(--sd, 0s));
  }
  .word-experiment { --wd: .12s; }
  .word-beta { --wd: .2s; }
  .word-world { --wd: .28s; }
  .word-07 { --wd: .36s; }
  @keyframes strip-in { to { --strip-reveal: -3%; } }


  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .text-field { z-index: 2; }
  .hero-clock { position: absolute; z-index: 3; top: 20px; left: 50%; transform: translateX(-50%); font: .74rem var(--mono); letter-spacing: .05em; }
  .hero-meta { position: absolute; z-index: 3; right: 24px; bottom: 16px; left: 24px; display: flex; align-items: center; gap: 16px; color: #767676; font: .68rem var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .hero-meta-center { margin-inline: auto; }
  .hero-scroll { color: var(--accent-strong); font-weight: 700; pointer-events: auto; }
  @media(max-width: 700px) {
    .word-ai { top: max(5%, 64px); left: 3%; font-size: 13.5vw; }
    .word-experiment { top: 20%; left: 15%; font-size: 11.5vw; }
    .word-beta { top: 42%; left: 2%; font-size: 11vw; }
    .word-world { top: 60%; right: 2%; left: auto; font-size: 11vw; }
    .word-07 { top: 78%; left: 44%; right: auto; bottom: auto; font-size: 11.5vw; }
    .hero-clock, .hero-meta-center { display: none; }
    .hero-meta { right: 16px; left: 16px; justify-content: flex-end; }
  }
  @media(prefers-reduced-motion: reduce) { :global(.hero-word .strip) { animation: none !important; --strip-reveal: -3% !important; } }
  .globe-readout { position: absolute; left: var(--world-left); bottom: 14%; display: grid; gap: 6px; color: #727272; font: clamp(12px, .9vw, 17px)/1.5 "Chivo Mono", var(--mono); font-variant-numeric: tabular-nums; }
  .globe-readout span { display: grid; grid-template-columns: 3ch max-content; column-gap: 1ch; }
  .globe-readout b { font-weight: 400; color: #252525; }
  .map-status { position: absolute; left: var(--world-left); bottom: 8%; max-width: 260px; margin: 0; font-size: 12px; color: #666666; }
  .globe-input:focus-visible { outline: 1px solid var(--ink); outline-offset: -5px; }
  @media(max-width: 600px) { .globe-readout { left: 6%; bottom: 7%; font-size: 11px; } }

  .world-title h2 { font: 700 clamp(30px, min(4.6vw, 6.7svh), 86px)/.98 "World Haas", "Helvetica Neue", Arial, var(--sans); letter-spacing: -.045em; text-transform: uppercase; color: #000; }
  .world-title-zh { display: none; }
  .world-title-zh span { display: block; }
  :global(html[lang="zh-CN"]) .world-title-en { display: none; }
  :global(html[lang="zh-CN"]) .world-title-zh { display: block; font-family: var(--sans); line-height: 1.16; font-size: clamp(26px, 3.8vw, 64px); letter-spacing: -.04em; }
  .title-line { display: flex; justify-content: space-between; white-space: nowrap; }
  .title-line:first-child, .title-line:nth-child(3) { width: 72%; }
  .world-time { position: absolute; left: 75.5%; top: 11%; display: grid; gap: 4px; font: clamp(12px, .9vw, 17px)/1.4 "Chivo Mono", var(--mono); font-variant-numeric: tabular-nums; }
  .world-time span { display: grid; grid-template-columns: 11ch max-content; column-gap: 1ch; color: #727272; } .world-time b { font-weight: 400; text-align: left; color: var(--ink); }
  .world-intro { position: absolute; left: 59%; bottom: 3.5%; width: 31.5%; max-width: 600px; color: #252525; }
  .world-now { display: flex; align-items: center; gap: 10px; width: fit-content; margin-top: 18px; font: 400 clamp(12px, .95vw, 16px)/1.4 var(--sans); }
  .now-label { display: flex; align-items: center; gap: 6px; color: #727272; font: 10px var(--mono); margin-right: 3px; }
  .now-label i { width: 4px; height: 4px; border-radius: 50%; background: var(--accent); }
  .world-now img { width: auto; height: clamp(17px, 1.55vw, 23px); }
  .now-arrow { transition: transform .3s; }
  .world-now:hover .now-arrow { transform: translate(2px,-2px); }
  .world-now:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
  .world-intro .intro-english { margin: 0; font: 500 clamp(16px, 1.3vw, 24px)/1.25 "Chivo Mono", var(--mono); text-align: justify; text-transform: uppercase; }
  .place-index, .gallery-places { display: flex; gap: 20px; margin-top: 20px; }
  .world-intro .place-index { margin-top: 16px; }
  .world-intro .place-index button { font-size: clamp(12px, .95vw, 16px); font-weight: 500; }
  .place-index button, .gallery-places button { border: 0; border-bottom: 1px solid #bcbcbc; background: none; padding: 5px 0; font-size: 11px; cursor: pointer; }
  .gallery-places button[aria-pressed="true"] { color: #e43c32; border-color: currentColor; }
  .map-pin { position: absolute; z-index: 2; width: 28px; height: 28px; padding: 0; transform: translate(-50%,-50%); border: 0; background: transparent; cursor: pointer; visibility: hidden; }
  .map-pin i { position: absolute; width: 8px; height: 8px; border-radius: 50%; background: #ef3c32; top: 10px; left: 10px; box-shadow: 0 0 0 3px #fdfdfd66; transition: transform .2s; }
  .map-pin:hover i, .map-pin[aria-expanded="true"] i { transform: scale(1.45); }
  .map-pin span { position: absolute; top: 15px; left: 23px; padding: 7px 9px; font: 10px var(--sans); white-space: nowrap; pointer-events: auto; }
  .map-pin[data-pin="1"] span { top: -14px; left: auto; right: 22px; }
  .map-pin[data-pin="2"] span { top: -18px; left: 14px; }
  .map-pin[data-pin="0"] { z-index: 3; }
  .map-pin span::before { content: ""; position: absolute; width: 14px; height: 1px; background: #aaaaaa; left: -9px; top: 3px; transform: rotate(35deg); transform-origin: right; pointer-events: none; }
  .map-pin[data-pin="1"] span::before { left: auto; right: -10px; top: auto; bottom: 3px; }
  .map-pin[data-pin="2"] span::before { display: none; }
  .place-gallery { position: absolute; z-index: 6; right: 5%; bottom: 17%; width: min(400px, 32vw); transform-origin: 0 0; pointer-events: auto; }
  .place-gallery[hidden], .world-intro[hidden], .photo-front img[hidden], .photo-placeholder[hidden] { display: none; }
  .place-gallery header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }
  .place-gallery header span { font: 10px "Space Mono", var(--mono); text-transform: uppercase; }
  .place-gallery h3 { margin: 5px 0 0; font: 400 28px/1.2 var(--sans); }
  .place-gallery header button { width: 36px; height: 36px; line-height: 1; display: grid; place-items: center; border: 0; background: none; font-size: 25px; padding: 8px; cursor: pointer; }
  .photo-deck { position: relative; aspect-ratio: 4/3; isolation: isolate; margin: 0 5px; }
  .photo-back, .photo-front { position: absolute; inset: 0; background: #e5e5e5; border: 1px solid #cecece; }
  .back-two { transform: rotate(-7deg) translate(-5px,2px); background: #ededed; }
  .back-one { transform: rotate(5deg) translate(5px,3px); background: #dddddd; }
  .photo-front { overflow: hidden; transform: rotate(-1deg); }
  .photo-front img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .photo-placeholder { display: flex; flex-direction: column; gap: 16px; padding: 24px 0; color: #252525; }
  .photo-placeholder > span { font: 11px/1.6 "Chivo Mono", var(--mono); }
  .photo-placeholder strong { font: 500 clamp(26px, 3vw, 40px)/1.1 var(--sans); letter-spacing: -.04em; }
  .photo-placeholder small { color: #727272; font: 12px var(--sans); }
  .place-gallery.is-empty .photo-deck { aspect-ratio: auto !important; margin: 0; }
  .place-gallery.is-empty .photo-front { position: relative; border: 0; background: none; transform: none; }
  .place-gallery.is-empty .photo-back, .place-gallery.is-single .photo-back { display: none; }
  .place-gallery [hidden] { display: none !important; }
  .place-gallery footer { display: flex; align-items: center; justify-content: space-between; margin-top: 15px; font: 10px "Space Mono", var(--mono); }
  .place-gallery footer button { font-size: 18px; border: 0; background: none; padding: 8px 10px; cursor: pointer; }
  .gallery-places { margin-top: 5px; }
  @media(min-width: 1100px) {
    /* The Poppins brand dot sits 113px after the navigation's 3% inset.
       Mirror the horizontal insets for the two opposing text blocks. */
    .world-copy { --title-edge: calc(3% + 81px); --title-inset: 50px; }
    .world-title { left: var(--title-edge); top: var(--title-inset); }
    .world-intro { left: auto; right: var(--title-edge); bottom: max(20px, 2.5svh); }
  }
  @media(max-width: 1099px) { .world-copy { --world-left: 8%; } .world-title { top: 14%; } .world-time { left: auto; right: 8%; top: 12%; } .globe-readout { bottom: 12%; } .world-intro { left: auto; width: 38%; right: 6%; bottom: 7%; } .place-gallery { width: 270px; bottom: 15%; padding: 15px; background: #fdfdfdf5; } .world-time { font-size: 12px; } }
  @media(max-width: 600px) {
    .globe-readout { left: 6%; bottom: 3%; }
    .world-copy { --world-left: 6%; } .world-title { left: 6%; top: 17%; width: 72%; } .world-title h2 { font-size: clamp(25px, 7.8vw, 44px); }
    .world-time { left: auto; right: 6%; top: 9%; font-size: 11px; gap: 3px; }
    .world-intro { left: auto; right: 6%; bottom: 9%; width: 78%; }
    .world-intro .intro-english { font-size: 14px; line-height: 1.3; }
    .world-intro .place-index { margin-top: 10px; gap: 22px; }
    .place-gallery { right: 6%; bottom: 12%; width: 78%; max-width: 320px; padding: 16px; }
    .place-gallery header { margin-bottom: 15px; } .place-gallery h3 { font-size: 23px; }
    .photo-deck { aspect-ratio: 1.7; } .photo-placeholder { padding: 12px; }
    .place-gallery footer { margin-top: 9px; } .gallery-places { gap: 22px; }
    .stage.gallery-open .earth { opacity: .45; } .earth { transition: opacity .3s; }
  }
  :global(html[data-reduced]) .now-arrow { transition: none; }
  @media(prefers-reduced-motion: reduce) { .map-pin i, .earth, .now-arrow { transition: none; } }

  /* Selected from 7-an/lab: five-word placement, scanning reveal and quiet Now line. */
/* Original five-word composition and pointer-led index. */
.opening .hero-words{display:block;z-index:2}
.opening .hero-word{font-weight:500;color:var(--ink);letter-spacing:-.065em;line-height:.98}
.opening .word-ai{top:12%;left:5.2%;font-size:clamp(64px,9vw,144px)}
.opening .word-experiment{top:29%;left:33%;font-size:clamp(64px,9vw,144px)}
.opening .word-beta{top:54%;left:7%;font-size:clamp(64px,9vw,144px)}
.opening .word-world{top:48%;right:5%;font-size:clamp(64px,9vw,144px);color:var(--accent)}
.opening .word-07{top:74%;left:49%;font-size:clamp(64px,9vw,144px)}
.opening canvas.text-field{opacity:.78}
.opening .text-overprint { position:absolute; inset:0; width:100%; height:100%; z-index:3; pointer-events:none; animation:overprint-in .8s ease 1.3s both; }
@keyframes overprint-in { from { opacity:0; } to { opacity:1; } }
@media(prefers-reduced-motion:reduce) { .opening .text-overprint { display:none; } }
:global(html[data-reduced]) .opening .text-overprint { display:none; }
:global(.opening .hero-word .strip){text-shadow:.02em 0 0 #fdfdfd}
:global(.opening .hero-word .strip:nth-child(3)){color:var(--accent)}
.hero-scanline{position:absolute;z-index:3;inset:0;pointer-events:none;opacity:var(--hero-fade,1);overflow:hidden}
.hero-scanline::after{content:'';position:absolute;left:0;right:0;top:-8%;height:7%;background:linear-gradient(transparent,#3164ff09 80%,#3164ff45);animation:display-scan 9s cubic-bezier(.2,.6,.2,1) infinite}
@keyframes display-scan{0%{transform:translateY(0);opacity:0}5%{opacity:.7}27%{transform:translateY(1600%);opacity:.25}28%,100%{transform:translateY(1600%);opacity:0}}

  .hero-meta { color: #6b6b6b; font-size: 12px; }
  .hero-clock { font-size: 12px; }
  .hero-scroll { font-size: 12px; padding: 14px 10px; margin: -14px -10px; }
  .opening::after { content: ""; position: absolute; inset: auto 0 0; height: 190px; background: linear-gradient(to top, var(--paper) 12%, #fdfdfdb8 55%, transparent); pointer-events: none; z-index: 2; opacity: var(--hero-fade, 1); }
  .world-intro { display: grid; justify-items: end; }
  .world-now { margin-top: 16px; gap: 9px; }
  .world-now > span { font-size: 13px; letter-spacing: 0; color: #6b6b6b; }
