---
import { featuredProjects } from "../config/projects";
import { externalWriting } from "../data/external-writing";

const project = featuredProjects[0];
const article = externalWriting.find((item) => item.media && item.externalUrl)!;
---

<div class="home-editorial" data-home-directory>
  <section class="directory" id="guide" data-screen-stop aria-labelledby="directory-heading">
    <header class="directory-head" data-reveal>
      <h2 id="directory-heading" class="mono">INDEX / EXPLORE FURTHER</h2>
      <span class="mono" aria-hidden="true">BUILD. WRITE. BECOME.</span>
    </header>
    <nav aria-label="Explore more about Ansyn">
      <a class="index-row work-row" data-directory-peek="work" href="/work/" aria-labelledby="work-label" data-reveal>
        <span class="row-number mono" aria-hidden="true">01</span>
        <div class="row-heading"><h3 id="work-label">WORK<span>Projects & experiments</span></h3></div>
        <div class="row-preview work-preview">
          <div class="project-image"><img src={project.gallery[0].src} alt={project.gallery[0].alt} width={project.gallery[0].width} height={project.gallery[0].height} loading="lazy" decoding="async" /></div>
          <p class="preview-caption mono"><span>{project.title}</span><span>OPEN SOURCE</span></p>
        </div>
        <span class="row-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="index-row writing-row" data-directory-peek="writing" href="/writing/" aria-labelledby="writing-label" data-reveal>
        <span class="row-number mono" aria-hidden="true">02</span>
        <div class="row-heading"><h3 id="writing-label">WRITING<span>Writing & field notes</span></h3></div>
        <div class="row-preview writing-preview">
          {article.media && <img class="article-image" src={article.media.src} width={article.media.width} height={article.media.height} alt={article.media.alt} loading="lazy" decoding="async" />}
          <p class="article-meta mono">{article.platform} / {article.publishDate?.replaceAll("-", ".")}</p>
          <p class="article-title" lang="zh-CN" data-preserve-language>{article.title}</p>
          <p class="article-excerpt">{article.description}</p>
        </div>
        <span class="row-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="index-row about-row" href="/about/" aria-labelledby="about-label" data-reveal>
        <span class="row-number mono" aria-hidden="true">03</span>
        <div class="row-heading"><h3 id="about-label">ABOUT<span>Background & approach</span></h3></div>
        <div class="row-preview about-preview">
          <img src="/ansyn-avatar-transparent.png" alt="" width="400" height="400" loading="lazy" decoding="async" />
          <div><p class="mono">ANSYN / ABOUT ME</p><p class="about-note">Making things with AI,<br />and keeping notes along the way.</p></div>
        </div>
        <span class="row-arrow" aria-hidden="true">↗</span>
      </a>
    </nav>
    <div class="directory-tail mono"><span>AN ONGOING EXPERIMENT</span><span>↓ KEEP IN TOUCH</span></div>
  </section>
</div>

<div class="directory-peek" data-directory-preview aria-hidden="true">
  <div class="peek-card" data-directory-card="work" hidden>
    <img src={project.gallery[0].src} alt="" width={project.gallery[0].width} height={project.gallery[0].height} loading="lazy" decoding="async" />
    <div class="peek-caption"><span>{project.title}</span><span>VIEW WORK ↗</span></div>
  </div>
  <div class="peek-card" data-directory-card="writing" hidden>
    {article.media && <img src={article.media.src} width={article.media.width} height={article.media.height} alt="" loading="lazy" decoding="async" />}
    <div class="peek-writing-copy"><span class="mono">FROM THE NOTEBOOK</span><p lang="zh-CN" data-preserve-language>{article.title}</p></div>
  </div>
</div>
<script>
  import { initHomeDirectory } from "../lib/home-directory";
  initHomeDirectory();
</script>

<style>
  .home-editorial { --gutter: calc(3vw + 113px); --display: "World Haas", "Helvetica Neue", Arial, var(--sans); padding-inline: var(--gutter); }
  .mono { font: 400 11px/1.5 "Chivo Mono", var(--mono); letter-spacing: .015em; }
  .directory { padding-block: 28px 38px; }
  .directory-head { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding-bottom: 22px; }
  .directory-head h2 { margin: 0; }
  .directory-head > span { color: var(--muted); font-size: 10px; }
  .index-row { display: grid; grid-template-columns: 28px minmax(0, 1fr) 27% 30px; align-items: center; gap: 22px; min-height: clamp(204px, 16vw, 260px); padding-block: 26px; border-top: 1px solid var(--line); position: relative; }
  .index-row:last-child { border-bottom: 1px solid var(--line); }
  .row-number { align-self: start; margin-top: 16px; color: #777; }
  .row-heading { min-width: 0; }
  .row-heading h3 { margin: 0; font: 600 clamp(44px, 6vw, 88px)/1 "Poppins", var(--sans); letter-spacing: -.055em; transition: transform .4s cubic-bezier(.2,.7,.2,1); }
  .row-heading h3 span { display: block; margin-top: 18px; font: 400 12px/1.5 var(--sans); letter-spacing: .025em; color: #666; }
  .row-preview { min-width: 0; }
  .project-image { overflow: hidden; background: #000; aspect-ratio: 2.05; }
  .project-image img { display: block; width: 100%; height: 100%; object-fit: contain; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .preview-caption { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px; margin: 10px 0 0; font-size: 9px; }
  .preview-caption span:last-child { color: var(--muted); }
  .article-image { display: block; width: 100%; height: auto; margin-bottom: 14px; }
  .article-meta { margin: 0 0 12px; font-size: 10px; color: var(--muted); }
  .article-title { margin: 0; font-size: clamp(15px, 1.25vw, 20px); font-weight: 500; line-height: 1.45; }
  .article-excerpt { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin: 12px 0 0; font-size: 12px; line-height: 1.6; color: #666; }
  .about-preview { display: flex; align-items: center; gap: 22px; }
  .about-preview img { width: 32%; max-width: 100px; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 50%; transition: transform .4s ease; }
  .about-preview .mono { margin: 0 0 10px; font-size: 10px; }
  .about-note { margin: 0; font-size: 12px; line-height: 1.6; }
  .row-arrow { grid-column: 4; justify-self: end; font: 400 34px/1 var(--sans); transition: transform .3s ease, color .3s ease; }
  .directory-tail { display: flex; justify-content: space-between; gap: 20px; padding-top: 30px; color: #777; font-size: 9px; }
  .index-row:focus-visible { outline-offset: 6px; }
  .index-row:focus-visible .row-heading h3 { transform: translateX(8px); }
  .index-row:focus-visible .row-arrow { color: var(--accent); transform: translate(3px, -3px); }
  @media(hover: hover) {
    .index-row:hover .row-heading h3 { transform: translateX(8px); }
    .index-row:hover .row-arrow { color: var(--accent); transform: translate(3px, -3px); }
    .index-row:hover .project-image img { transform: scale(1.06); }
    .index-row:hover .article-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
    .index-row:hover .about-preview img { transform: rotate(-6deg); }
  }
  @media(max-width: 1099px) {
    .home-editorial { --gutter: 6vw; }
    .index-row { gap: 16px; grid-template-columns: 24px minmax(0, 1fr) 30% 28px; }
    .row-heading h3 { font-size: clamp(44px, 6vw, 88px); }

    .about-preview { gap: 12px; }
  }
  @media(max-width: 650px) {
    .directory { padding-top: 16px; }
    .directory-head > span { display: none; }
    .index-row { grid-template-columns: 22px minmax(0, 1fr) 24px; gap: 22px 12px; padding-block: 28px; }
    .row-number { margin-top: 8px; }
    .row-heading h3 { font-size: 42px; }
    .row-heading h3 span { margin-top: 10px; font-size: 11px; }
    .row-arrow { grid-row: 1; grid-column: 3; font-size: 28px; }
    .row-preview { grid-row: 2; grid-column: 2 / 4; }
    .project-image { max-width: 340px; }
    .article-title { font-size: 17px; }
    .about-preview img { width: 64px; }
    .about-note { font-size: 13px; }
    .directory-tail { font-size: 8px; gap: 10px; }
  }
  .directory-peek { position: fixed; z-index: 35; top: 0; left: 0; width: clamp(260px, 28vw, 420px); pointer-events: none; opacity: 0; visibility: hidden; transition: opacity .2s ease, visibility .2s; }
  .directory-peek.is-visible { opacity: 1; visibility: visible; }
  .peek-card { padding: 10px; border: 1px solid #cecece; background: #f0f0f0; box-shadow: 0 22px 60px #00000026; overflow: hidden; transform: scale(.88) rotate(-4deg); clip-path: inset(10% 0 10% 0); transition: transform .5s cubic-bezier(.16,1,.3,1), clip-path .5s cubic-bezier(.16,1,.3,1); }
  .peek-card[hidden] { display: none; }
  .directory-peek.is-visible .peek-card { transform: scale(1) rotate(2deg); clip-path: inset(0); }
  .peek-card img { display: block; width: 100%; height: auto; aspect-ratio: 16/10; object-fit: contain; background: #0f0f0f; }
  .peek-caption { display: flex; justify-content: space-between; gap: 15px; padding: 14px 6px 8px; font: 11px var(--mono); }
  .peek-writing-copy { padding: 14px 6px 8px; }
  .peek-writing-copy > span { color: #777; font-size: 9px; }
  .peek-writing-copy p { margin: 8px 0 0; font-size: 16px; line-height: 1.6; }
  @media (min-width: 760px) and (hover: hover) and (pointer: fine) {
    [data-directory-ready] :is(.work-row, .writing-row) .row-preview { display: none; }
    [data-directory-ready] :is(.work-row, .writing-row) .row-heading { grid-column: 2 / 4; }
  }
  @media (max-width: 759px), (hover: none), (pointer: coarse) { .directory-peek { display: none; } }
  @media(prefers-reduced-motion: reduce) {
    .directory-peek, .peek-card { transition: none; }
    .peek-card, .directory-peek.is-visible .peek-card { transform: none; clip-path: none; }

    .row-heading h3, .row-arrow, .project-image img, .about-preview img { transition: none; transform: none !important; }
  }
  :global(html[data-reduced]) :is(.directory-peek, .peek-card) { transition: none; }
  :global(html[data-reduced]) .peek-card { transform: none; clip-path: none; }
  :global(html[data-reduced]) :is(.row-heading h3, .row-arrow, .project-image img, .about-preview img) { transition: none; transform: none !important; }

  @media(min-width:900px) and (min-height:620px) {
    .directory { display:grid; grid-template-rows:auto minmax(0,1fr) auto; height:100svh; padding:100px 0 30px; }
    .directory > nav { display:grid; grid-template-rows:repeat(3,minmax(0,1fr)); }
    .index-row { min-height:0; padding-block:20px; }
    .row-heading h3 { font-size: clamp(42px, min(6vw, 8svh), 88px); }
  }
</style>
