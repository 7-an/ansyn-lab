---
import { siteConfig } from "../config/site";
import SocialLinks from "./SocialLinks.astro";
---

<footer class="site-footer" id="contact">
  <div class="shell footer-contact">
    <p class="footer-giant" aria-hidden="true">LET'S<br />CONNECT.</p>
    <h2>从一个具体问题开始。</h2>
    <p>如果你在做 AI、内容、社区或年轻用户相关的项目——欢迎联系我。<br />目前愿意参与：AI 工作流、内容、社群系统与网站交付。</p>
    <div class="footer-channels">
      <nav aria-label="联系安寻">
        <span class="footer-channel-label">联系我 / PERSONAL</span>
        <div class="footer-channel-icons">
          <SocialLinks networks={["telegram", "x", "github"]} />
        </div>
      </nav>
      <nav aria-label="联系 KOSX">
        <span class="footer-channel-label">联系 KOSX / ORGANIZATION</span>
        <div class="footer-channel-links">
          <a href={siteConfig.kosx.url} target="_blank" rel="noopener noreferrer">KOSX.ai ↗</a>
        </div>
        <p class="footer-channel-note">企业 AI 项目 · 社群与人才合作 · Builder 协作</p>
      </nav>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} 安寻 Ansyn</span>
    <span>Building in public since 18.</span>
  </div>
</footer>
