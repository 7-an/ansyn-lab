---
interface Props {
  title: string;
  description: string;
  platform: string;
  category: string;
  href?: string;
  external?: boolean;
  publishDate?: Date | string;
  tags?: string[];
  featured?: boolean;
}

const {
  title,
  description,
  platform,
  category,
  href,
  external = false,
  publishDate,
  tags = [],
  featured = false
} = Astro.props;

const date = publishDate
  ? new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" }).format(
      new Date(publishDate)
    )
  : undefined;
const actionLabel = external ? `前往${platform}阅读` : "站内阅读全文";
---

<article class:list={["article-card", { featured }]}>
  <div class="article-meta">
    <span class="platform-badge">{platform}</span>
    <span>{category}</span>
    {date && <span>{date}</span>}
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  {tags.length > 0 && (
    <ul class="tag-list" aria-label="标签">
      {tags.slice(0, 3).map((tag) => <li>#{tag}</li>)}
    </ul>
  )}
  {href && (
    <div class="article-action">
      <a
        class="text-link"
        href={href}
        target={external ? "_blank" : undefined}
        rel={external ? "noopener noreferrer" : undefined}
        aria-label={`${actionLabel}：${title}`}
      >
        {actionLabel} <span aria-hidden="true">{external ? "↗" : "→"}</span>
      </a>
    </div>
  )}
</article>
