---
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const coordinates = [
  ["BUILD", "用 AI 与公开互联网完成真实项目"],
  ["WRITE", "记录行动、判断、错误与修正"],
  ["EXPLORE", "从高中系统进入真实协作网络"]
] as const;
---

<BaseLayout>
  <section class="lab-hero shell" aria-labelledby="home-title">
    <div class="lab-hero-copy" data-reveal data-reveal-delay="1">
      <p class="lab-kicker">BUILDING IN PUBLIC / SINCE 18</p>
      <h1 id="home-title" data-proximity><span class="lm"><span class="lm-in">安寻 <span class="latin">Ansyn</span></span></span></h1>
      <p class="lab-question"><span class="lm"><span class="lm-in">一个年轻人，如何在 AI 时代建立自己的能力系统？</span></span></p>
      <p class="lab-note">AI Workflow Builder · 现于 KOSX.ai 实习</p>
      <div class="lab-actions">
        <a class="button button-primary" href="/about/">阅读我的故事 <span aria-hidden="true">→</span></a>
        <a class="button" href="#guide">查看精选内容</a>
      </div>
      <div class="lab-contact-links">
        <a class="lab-text-link" href={siteConfig.social.x} target="_blank" rel="noopener noreferrer">在 X 联系我 ↗</a>
        <a class="lab-text-link" href={siteConfig.social.telegram} target="_blank" rel="noopener noreferrer">Telegram ↗</a>
      </div>
    </div>

    <figure class="lab-portrait" data-reveal data-reveal-delay="2" data-particle-portrait>
        <div class="particle-stage">
          <canvas class="particle-canvas" aria-hidden="true"></canvas>
          <img
            src="/ansyn-avatar-transparent.png"
            alt="安寻的个人形象：戴草帽的黑白漫画头像"
            width="400"
            height="400"
            loading="eager"
            fetchpriority="high"
          />
        </div>
    </figure>
  </section>

  <section class="home-section current-section shell" id="current" aria-labelledby="current-title">
    <header class="section-head" data-reveal>
      <div class="section-index">
        <span>01</span>
        <p>CURRENT COORDINATE / 当前坐标</p>
      </div>
      <h2 id="current-title">在真实世界里，<br /><em>边做边校正。</em></h2>
      <span class="section-status">2026—NOW / BUILDING</span>
    </header>

    <div class="current-layout">
      <figure class="field-photo field-photo-primary" data-reveal>
        <div class="photo-frame">
          <img
            src="/images/kosx-field-note.jpg"
            alt="KOSX 线下见面时，三个人在窗前展示各自的 X 主页"
            width="1200"
            height="1594"
            loading="lazy"
          />
          <span class="photo-code" aria-hidden="true">FIELD NOTE / 001</span>
        </div>
        <figcaption><span>KOSX 线下见面</span><span>现场记录 / CURRENT</span></figcaption>
      </figure>

      <div class="current-story">
        <figure class="field-photo field-photo-secondary" data-reveal data-reveal-delay="1">
          <div class="photo-frame">
            <img
              src="/images/kosx-ansyn-lab-sharing.jpg"
              alt="漫画风格的 KOSX 线下会议现场，屏幕上正在展示 Ansyn Lab 首页"
              width="1600"
              height="900"
              loading="lazy"
            />
            <span class="photo-code" aria-hidden="true">EVIDENCE / 002</span>
          </div>
          <figcaption><span>分享 Ansyn Lab</span><span>真实协作 / EVIDENCE</span></figcaption>
        </figure>

        <div class="coordinate-copy" data-reveal data-reveal-delay="2">
          <div class="coordinate-heading">
            <img class="coordinate-logo" src="/kosx-mark-black.png" alt="KOSX 标志" width="397" height="397" />
            <div>
              <p>WORK AT KOSX / 当前组织</p>
              <h3>KOSX.ai</h3>
            </div>
          </div>
          <p class="coordinate-intro">我目前以实习成员身份参与 KOSX 的早期建设。这里不是我的身份标签，而是我第一次把学习放进真实项目、协作与反馈里接受检验的地方。</p>
          <ol class="coordinate-list">
            {coordinates.map(([label, text], index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")} / {label}</span>
                <strong>{text}</strong>
              </li>
            ))}
          </ol>
          <a class="inline-link" href={siteConfig.kosx.url} target="_blank" rel="noopener noreferrer">了解 KOSX <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section home-guide shell" id="guide" aria-label="前往项目与文章页面">
    <div class="guide-grid">
      <a class="guide-card" href="/work/" data-reveal>
        <span>PROJECTS / 项目与交付</span>
        <h3>项目</h3>
        <p>独立项目与组织协作，每张卡写清角色、交付和下一步。</p>
        <i aria-hidden="true">→</i>
      </a>
      <a class="guide-card" href="/writing/" data-reveal data-reveal-delay="1">
        <span>WRITING / 公开内容</span>
        <h3>文章</h3>
        <p>发布在 X 等外部平台的思考与复盘，点击前往原文。</p>
        <i aria-hidden="true">→</i>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-kicker,
  .section-index,
  .section-status,
  .photo-code,
  .field-photo figcaption,
  .coordinate-heading p,
  .guide-card > span {
    font-family: var(--mono);
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .home-hero,
  .home-section { border-inline: 1px solid var(--line); }

  .home-hero {
    min-height: calc(100svh - 72px);
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--ink);
    overflow: hidden;
  }

  .hero-rail,
  .hero-footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    color: var(--muted);
    font: 650 .65rem/1.4 var(--mono);
    letter-spacing: .08em;
  }

  .hero-rail { padding: 18px clamp(20px, 4vw, 54px); border-bottom: 1px solid var(--line); }
  .hero-footer { padding: 20px clamp(20px, 4vw, 54px); border-top: 1px solid var(--line); }

  .hero-grid {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(330px, .92fr);
    align-items: center;
    gap: clamp(42px, 7vw, 110px);
    padding: clamp(62px, 8vw, 110px) clamp(22px, 5vw, 70px);
  }

  .home-kicker { margin: 0; color: var(--accent-strong); font-size: .72rem; font-weight: 760; }

  .hero-copy h1 {
    display: flex;
    align-items: baseline;
    gap: .16em;
    margin: 26px 0 0;
    font-size: clamp(5rem, 9vw, 8.6rem);
    font-weight: 900;
    line-height: .84;
    letter-spacing: -.085em;
    white-space: nowrap;
  }

  .hero-copy h1 small { font-size: .45em; font-weight: 780; letter-spacing: -.055em; }

  .hero-question {
    max-width: 660px;
    margin: 38px 0 0;
    font-size: clamp(1.45rem, 2.45vw, 2.1rem);
    font-weight: 730;
    line-height: 1.42;
    letter-spacing: -.04em;
    text-wrap: balance;
  }

  .hero-summary { max-width: 590px; margin: 18px 0 0; color: var(--muted); font-size: .98rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }

  .hero-portrait {
    position: relative;
    width: min(100%, 500px);
    margin: 0 auto;
    overflow: visible;
  }

  .particle-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    margin-inline: auto;
    isolation: isolate;
  }

  .particle-stage img,
  .particle-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .particle-stage img {
    object-fit: contain;
    filter: grayscale(1) contrast(1.08);
    mix-blend-mode: multiply;
    transition: opacity .38s ease, filter .38s ease;
  }

  .particle-canvas {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity .58s ease;
  }

  :global([data-particle-portrait].particle-ready) .particle-stage img { opacity: 0; }
  :global([data-particle-portrait].particle-ready) .particle-canvas { opacity: 1; }
  :global([data-particle-portrait].particle-base-visible) .particle-stage img {
    opacity: 1;
    filter: grayscale(1) contrast(1.08);
  }
  :global([data-particle-portrait].particle-settled) .particle-canvas { opacity: .14; }

  .lab-kicker {
    margin: 0;
    color: var(--accent-strong);
    font: 750 .74rem/1.4 var(--mono);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .lab-hero {
    min-height: calc(100svh - 72px);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr);
    align-items: center;
    gap: clamp(32px, 7vw, 110px);
    padding-block: clamp(76px, 10vw, 132px);
    border-inline: 1px solid var(--line);
    overflow: hidden;
  }

  .lab-hero-copy {
    z-index: 1;
    padding-left: clamp(22px, 5vw, 74px);
  }

  .lab-hero h1 {
    display: flex;
    align-items: baseline;
    gap: .14em;
    margin: 30px 0 0;
    font-size: clamp(4.6rem, 8.4vw, 8.2rem);
    font-weight: 900;
    line-height: .9;
    letter-spacing: -.08em;
    white-space: nowrap;
  }

  .lab-hero h1 .latin {
    font-size: .55em;
    font-weight: 790;
    letter-spacing: -.05em;
  }

  .lab-question {
    max-width: 690px;
    margin: 34px 0 0;
    font-size: clamp(1.45rem, 2.5vw, 2.15rem);
    font-weight: 720;
    line-height: 1.42;
    letter-spacing: -.035em;
    text-wrap: balance;
  }

  .lab-note {
    margin: 14px 0 0;
    color: var(--muted);
    font-size: .92rem;
  }

  .lab-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .lab-contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 26px;
  }

  .lab-text-link {
    display: inline-flex;
    color: var(--accent-strong);
    font-weight: 800;
    border-bottom: 1px solid currentColor;
  }

  .lab-text-link:hover { color: var(--ink); }

  .lab-portrait {
    align-self: center;
    margin: 0;
    padding-right: clamp(18px, 4vw, 58px);
  }

  .lab-portrait .particle-stage {
    width: min(100%, 540px);
  }

  .lab-portrait img {
    display: block;
    width: min(100%, 540px);
    height: auto;
    margin-inline: auto;
    filter: grayscale(1) contrast(1.08);
    mix-blend-mode: multiply;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0, #000 4%, #000 96%, transparent 100%),
      linear-gradient(to bottom, transparent 0, #000 4%, #000 84%, transparent 99%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0, #000 4%, #000 96%, transparent 100%),
      linear-gradient(to bottom, transparent 0, #000 4%, #000 84%, transparent 99%);
    mask-composite: intersect;
  }

  .js .lab-hero .lm-in {
    transform: translateY(112%);
    transition: transform .9s cubic-bezier(.22, 1, .36, 1);
  }

  .lab-hero .is-revealed .lm-in { transform: none; }
  .js .lab-question .lm-in { transition-delay: .15s; }

  .lab-hero h1 .lm {
    padding-bottom: .12em;
    margin-bottom: -.12em;
  }

  .home-section {
    padding: clamp(92px, 11vw, 148px) clamp(22px, 5vw, 70px);
    border-bottom: 1px solid var(--ink);
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(170px, .55fr) minmax(0, 1.45fr) auto;
    align-items: end;
    gap: 40px;
    padding-bottom: clamp(34px, 4vw, 52px);
    border-bottom: 1px solid var(--ink);
  }

  .section-head h2 {
    margin: 0;
    font-size: clamp(3rem, 5.9vw, 5.7rem);
    line-height: .98;
    letter-spacing: -.068em;
  }

  .section-head h2 em { color: var(--accent-strong); font-style: normal; }
  .section-index { display: flex; align-items: center; gap: 16px; align-self: start; }
  .section-index > span { color: var(--accent-strong); font-size: .82rem; font-weight: 800; }
  .section-index p { margin: 0; color: var(--muted); font-size: .68rem; font-weight: 700; }
  .section-status { color: var(--accent-strong); font-size: .7rem; font-weight: 750; white-space: nowrap; }
  .section-link { align-self: end; color: var(--accent-strong); font: 760 .78rem var(--mono); border-bottom: 1px solid currentColor; }

  .current-layout {
    display: grid;
    grid-template-columns: minmax(300px, .82fr) minmax(0, 1.18fr);
    gap: clamp(32px, 5vw, 70px);
    margin-top: clamp(42px, 6vw, 78px);
  }

  .field-photo { margin: 0; }
  .photo-frame { position: relative; overflow: hidden; background: var(--paper-deep); }
  .photo-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(145deg, rgba(53, 107, 255, .08), transparent 44%);
    mix-blend-mode: multiply;
  }

  .field-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .8s cubic-bezier(.22, 1, .36, 1), filter .5s ease;
  }
  .field-photo:hover img { transform: scale(1.025); filter: saturate(.9) contrast(1.03); }
  .field-photo-primary .photo-frame { aspect-ratio: 4 / 5; }
  .field-photo-primary img { object-position: center 44%; }
  .field-photo-secondary .photo-frame { aspect-ratio: 16 / 9; }

  .photo-code {
    position: absolute;
    z-index: 2;
    top: 14px;
    left: 14px;
    padding: 7px 9px;
    background: rgba(21, 23, 26, .88);
    color: var(--white);
    font-size: .62rem;
  }

  .field-photo figcaption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 12px;
    color: var(--muted);
    font-size: .62rem;
  }

  .current-story { display: flex; flex-direction: column; gap: clamp(42px, 5vw, 64px); }
  .coordinate-copy { border-top: 1px solid var(--ink); padding-top: 30px; }
  .coordinate-heading { display: flex; align-items: center; gap: 18px; }
  .coordinate-logo { display: block; width: 54px; height: 54px; object-fit: contain; }
  .coordinate-heading p { margin: 0; color: var(--accent-strong); font-size: .66rem; font-weight: 760; }
  .coordinate-heading h3 { margin: 4px 0 0; font-size: 2rem; letter-spacing: -.05em; }
  .coordinate-intro { max-width: 690px; margin: 26px 0 0; font-size: 1.08rem; font-weight: 620; }

  .coordinate-list { margin: 32px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .coordinate-list li {
    display: grid;
    grid-template-columns: 155px 1fr;
    gap: 20px;
    padding: 17px 0;
    border-bottom: 1px solid var(--line);
  }
  .coordinate-list span { color: var(--accent-strong); font: 720 .64rem var(--mono); }
  .coordinate-list strong { font-size: .92rem; font-weight: 660; }
  .inline-link { display: inline-flex; gap: 8px; margin-top: 28px; color: var(--accent-strong); font-weight: 800; border-bottom: 1px solid currentColor; }

  .home-guide { padding-bottom: clamp(116px, 13vw, 180px); }

  .guide-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--ink);
  }

  .guide-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 280px;
    padding: clamp(26px, 3.5vw, 44px);
    transition: background .18s ease, color .18s ease;
  }

  .guide-card + .guide-card { border-left: 1px solid var(--ink); }

  .guide-card span {
    color: var(--accent-strong);
    font: 750 .74rem var(--mono);
    letter-spacing: .08em;
    transition: color .18s ease;
  }

  .guide-card h3 {
    margin: 26px 0 14px;
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    letter-spacing: -.05em;
    transition: color .18s ease;
  }

  .guide-card p {
    max-width: 420px;
    margin: 0;
    color: var(--muted);
    transition: color .18s ease;
  }

  .guide-card i {
    margin-top: auto;
    padding-top: 30px;
    font-style: normal;
    font-size: 1.6rem;
    transition: transform .18s ease;
  }

  .guide-card:hover { background: var(--ink); color: var(--paper); }
  .guide-card:hover span { color: #7fa0ff; }
  .guide-card:hover p { color: #b9bbb4; }
  .guide-card:hover i { transform: translateX(8px); }

  @media (max-width: 900px) {
    .lab-hero {
      min-height: auto;
      grid-template-columns: 1fr .72fr;
      gap: 20px;
      padding-block: 84px;
    }
    .lab-hero h1 { font-size: clamp(4rem, 10vw, 6rem); }
    .section-head { grid-template-columns: 1fr; align-items: start; gap: 26px; }
    .section-link,
    .section-status { justify-self: start; }
    .current-layout { grid-template-columns: .78fr 1.22fr; gap: 28px; }
  }

  @media (max-width: 700px) {
    .home-section { border-inline: 0; }
    .lab-hero {
      grid-template-columns: 1fr;
      padding: 68px 18px 36px;
      border-inline: 0;
    }
    .lab-hero-copy { padding: 0; }
    .lab-hero h1 { flex-wrap: wrap; font-size: clamp(4.2rem, 20vw, 6.4rem); white-space: normal; }
    .lab-hero h1 .latin { font-size: .43em; }
    .lab-actions { align-items: stretch; flex-direction: column; }
    .lab-actions .button { width: 100%; }
    .lab-contact-links { flex-direction: column; gap: 10px; }
    .lab-portrait { padding: 20px 10px 0; }
    .lab-portrait img { width: 100%; }
    .home-section { padding-inline: 18px; }
    .section-head h2 { font-size: clamp(2.8rem, 14.5vw, 4.4rem); }
    .current-layout { grid-template-columns: 1fr; }
    .field-photo-primary .photo-frame { aspect-ratio: 4 / 4.6; }
    .current-story { gap: 44px; }
    .coordinate-list li { grid-template-columns: 1fr; gap: 8px; }
    .guide-grid { grid-template-columns: 1fr; }
    .guide-card { min-height: 220px; }
    .guide-card + .guide-card { border-top: 1px solid var(--ink); border-left: 0; }
  }
</style>

<script>
  const particlePortrait = document.querySelector<HTMLElement>("[data-particle-portrait]");
  const particleStage = particlePortrait?.querySelector<HTMLElement>(".particle-stage");
  const particleCanvas = particleStage?.querySelector<HTMLCanvasElement>(".particle-canvas");
  const particleImage = particleStage?.querySelector<HTMLImageElement>("img");
  const particleMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  type PortraitParticle = {
    nx: number;
    ny: number;
    tx: number;
    ty: number;
    sx: number;
    sy: number;
    size: number;
    delay: number;
    duration: number;
    phase: number;
  };

  if (particlePortrait && particleStage && particleCanvas && particleImage && !particleMotion.matches) {
    const startParticleReveal = () => {
      if (particlePortrait.dataset.particleStarted === "true") return;

      const firstRect = particleStage.getBoundingClientRect();
      if (firstRect.width < 2 || firstRect.height < 2) {
        window.setTimeout(startParticleReveal, 80);
        return;
      }

      const context = particleCanvas.getContext("2d");
      if (!context) return;
      particlePortrait.dataset.particleStarted = "true";

      const pixelRatio = Math.min(window.devicePixelRatio || 1, 1.6);
      const extensionRatio = firstRect.width < 420 ? .38 : .56;
      let stageWidth = firstRect.width;
      let stageHeight = firstRect.height;
      let extension = stageWidth * extensionRatio;
      let canvasWidth = stageWidth + extension;
      let particles: PortraitParticle[] = [];
      let startedAt = performance.now();
      let frameId = 0;
      let baseVisible = false;
      let settled = false;
      const pointer = { x: -9999, y: -9999, active: false };

      const measure = () => {
        const rect = particleStage.getBoundingClientRect();
        stageWidth = rect.width;
        stageHeight = rect.height;
        extension = stageWidth * extensionRatio;
        canvasWidth = stageWidth + extension;
        particleCanvas.style.left = `${-extension}px`;
        particleCanvas.style.width = `${canvasWidth}px`;
        particleCanvas.style.height = `${stageHeight}px`;
        particleCanvas.width = Math.round(canvasWidth * pixelRatio);
        particleCanvas.height = Math.round(stageHeight * pixelRatio);
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      };

      const layoutParticles = (first = false) => {
        particles.forEach((particle) => {
          particle.tx = extension + particle.nx * stageWidth;
          particle.ty = particle.ny * stageHeight;
          if (!first) return;
          particle.sx = extension * (.04 + Math.random() * .78);
          particle.sy = particle.ty + (Math.random() - .5) * Math.min(170, stageHeight * .42);
        });
      };

      const sampleImage = () => {
        const sampleCanvas = document.createElement("canvas");
        const sampleWidth = Math.min(window.innerWidth < 680 ? 280 : 400, particleImage.naturalWidth);
        const sampleHeight = Math.max(1, Math.round(sampleWidth * particleImage.naturalHeight / particleImage.naturalWidth));
        sampleCanvas.width = sampleWidth;
        sampleCanvas.height = sampleHeight;
        const sampleContext = sampleCanvas.getContext("2d", { willReadFrequently: true });
        if (!sampleContext) return;
        sampleContext.drawImage(particleImage, 0, 0, sampleWidth, sampleHeight);
        const pixels = sampleContext.getImageData(0, 0, sampleWidth, sampleHeight).data;

        let subjectPixels = 0;
        for (let offset = 0; offset < pixels.length; offset += 4) {
          const max = Math.max(pixels[offset], pixels[offset + 1], pixels[offset + 2]);
          const min = Math.min(pixels[offset], pixels[offset + 1], pixels[offset + 2]);
          const isBackground = pixels[offset + 3] < 80 || ((max + min) / 2 > 218 && max - min < 34);
          if (!isBackground) subjectPixels += 1;
        }

        const targetCount = window.innerWidth < 680 ? 8200 : 15000;
        const step = Math.max(1, Math.round(Math.sqrt(subjectPixels / targetCount)));
        const nextParticles: PortraitParticle[] = [];

        for (let y = 0; y < sampleHeight; y += step) {
          for (let x = 0; x < sampleWidth; x += step) {
            const offset = (y * sampleWidth + x) * 4;
            const max = Math.max(pixels[offset], pixels[offset + 1], pixels[offset + 2]);
            const min = Math.min(pixels[offset], pixels[offset + 1], pixels[offset + 2]);
            const isBackground = pixels[offset + 3] < 80 || ((max + min) / 2 > 218 && max - min < 34);
            if (isBackground) continue;
            const nx = x / sampleWidth;
            nextParticles.push({
              nx,
              ny: y / sampleHeight,
              tx: 0,
              ty: 0,
              sx: 0,
              sy: 0,
              size: .82 + Math.random() * 1.02,
              delay: nx * 620 + Math.random() * 230,
              duration: 760 + Math.random() * 520,
              phase: Math.random() * Math.PI * 2
            });
          }
        }

        particles = nextParticles;
        layoutParticles(true);
      };

      const easeOut = (value: number) => 1 - Math.pow(1 - value, 3);
      const settleAt = 1750;
      const revealBaseAt = 1880;
      const softenParticlesAt = 2280;

      const draw = (now: number) => {
        const elapsed = now - startedAt;
        if (!baseVisible && elapsed >= revealBaseAt) {
          particlePortrait.classList.add("particle-base-visible");
          baseVisible = true;
        }
        if (!settled && elapsed >= softenParticlesAt) {
          particlePortrait.classList.add("particle-settled");
          settled = true;
        }

        context.clearRect(0, 0, canvasWidth, stageHeight);
        const time = now * .001;

        particles.forEach((particle) => {
          let x = particle.tx;
          let y = particle.ty;
          let alpha = 1;
          let hoverBoost = 0;

          if (elapsed < settleAt) {
            const local = (elapsed - particle.delay) / particle.duration;
            const progress = local <= 0 ? 0 : local >= 1 ? 1 : easeOut(local);
            x = particle.sx + (particle.tx - particle.sx) * progress;
            y = particle.sy + (particle.ty - particle.sy) * progress;
            alpha = Math.max(0, Math.min(1, local + .14));
          } else {
            x += Math.sin(time * .9 + particle.phase) * .34;
            y += Math.cos(time * .72 + particle.phase) * .42;

            if (pointer.active) {
              const dx = x - pointer.x;
              const dy = y - pointer.y;
              const radius = Math.max(86, Math.min(132, stageWidth * .22));
              const distanceSquared = dx * dx + dy * dy;
              if (distanceSquared < radius * radius) {
                const distance = Math.sqrt(distanceSquared) || 1;
                hoverBoost = 1 - distance / radius;
                const force = hoverBoost * 16;
                x += dx / distance * force;
                y += dy / distance * force;
              }
            }
          }

          if (alpha <= .01) return;
          context.fillStyle = "#030405";
          const size = particle.size * (1 + hoverBoost * .5);
          context.globalAlpha = alpha * .16;
          context.fillRect(x - .35, y - .35, size + .7, size + .7);
          context.globalAlpha = alpha;
          context.fillRect(x, y, size, size);
        });

        context.globalAlpha = 1;
        frameId = window.requestAnimationFrame(draw);
      };

      let resizeTimer = 0;
      window.addEventListener("resize", () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          measure();
          layoutParticles(false);
        }, 150);
      });

      particlePortrait.addEventListener("pointermove", (event) => {
        const rect = particleCanvas.getBoundingClientRect();
        pointer.x = event.clientX - rect.left;
        pointer.y = event.clientY - rect.top;
        pointer.active = true;
      });
      particlePortrait.addEventListener("pointerleave", () => { pointer.active = false; });
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) window.cancelAnimationFrame(frameId);
        else {
          startedAt = performance.now() - (settleAt + 100);
          frameId = window.requestAnimationFrame(draw);
        }
      });

      measure();
      sampleImage();
      particlePortrait.classList.add("particle-ready");
      startedAt = performance.now();
      frameId = window.requestAnimationFrame(draw);
    };

    const scheduleParticleReveal = async () => {
      try { await particleImage.decode(); } catch { /* load event already confirms a usable image */ }
      window.requestAnimationFrame(() => window.requestAnimationFrame(startParticleReveal));
    };

    if (particleImage.complete && particleImage.naturalWidth > 0) void scheduleParticleReveal();
    else particleImage.addEventListener("load", () => { void scheduleParticleReveal(); }, { once: true });
  }
</script>
