---
import { externalWriting, platformLabels } from "../data/external-writing";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import SectionHeading from "../components/SectionHeading.astro";

const featuredOrder = [
  "参加AI创业交流会后，我学到的九件事",
  "重新介绍一下自己：一个07后为什么开始探索AI、创业和Web3",
  "我理解AI的第一堂课，来自一段失败的恋爱",
  "高三提分不是靠鸡血，而是一套能跑起来的学习系统"
];
const featured = featuredOrder
  .map((title) => externalWriting.find((article) => article.title === title))
  .filter((article) => article !== undefined);

const directions = [
  {
    index: "01",
    title: "AI × 个人成长",
    copy: "研究如何把 AI 从聊天工具，变成学习、思考、创作和解决现实问题的杠杆。"
  },
  {
    index: "02",
    title: "个人系统",
    copy: "研究记录、复盘、判断、执行和反馈如何形成长期闭环。"
  },
  {
    index: "03",
    title: "全球互联网与商业",
    copy: "探索全球信息、Web3、内容创作、个人 IP 和真实价值交换。"
  }
];

const experiments = [
  { title: "学会真正使用AI", status: "进行中", tone: "active", copy: "不是收藏更多工具，而是提高定义问题、验证答案和回到现实行动的能力。" },
  { title: "建立低摩擦记录系统", status: "准备中", tone: "ready", copy: "探索如何通过语音输入、Obsidian 和 AI，降低记录和复盘的启动成本。" },
  { title: "从零理解Web3", status: "学习中", tone: "learning", copy: "先理解基础逻辑、安全边界、真实需求和行业结构，不急着包装成专家。" },
  { title: "第一个商业闭环", status: "尚未开始", tone: "idle", copy: "尝试从真实用户、真实问题和第一次价值交换开始，而不是先写宏大的商业计划。" }
];
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-signal" aria-label="当前状态：正在构建">
      <span class="signal-dot"></span>
      LIVE EXPERIMENT / 2026—NOW
    </div>
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Building in public.</p>
        <h1>安寻 <span>Ansyn</span></h1>
        <p class="hero-age">07后，18岁，刚高中毕业。</p>
        <p class="hero-statement">记录一个年轻人如何利用 <mark>AI</mark>、互联网和个人系统，从高中环境进入真实世界。</p>
        <div class="button-row">
          <a class="button button-primary" href="/about/">阅读我的故事 <span aria-hidden="true">→</span></a>
          <a class="button" href="#experiments">查看正在进行的实验</a>
          <a class="text-link hero-x" href={siteConfig.social.x} target="_blank" rel="noopener noreferrer">在 X 联系我 ↗</a>
        </div>
      </div>
      <aside class="hero-terminal" aria-label="Ansyn Lab 终端状态">
        <div class="terminal-top"><span>ANSYN_OS</span><span>v0.1</span></div>
        <div class="terminal-body">
          <p><span>identity</span><strong>07 / CREATOR</strong></p>
          <p><span>mode</span><strong>BUILDING</strong></p>
          <p><span>location</span><strong>REAL WORLD ENTRY</strong></p>
          <p><span>certainty</span><strong>LOW, TESTING</strong></p>
        </div>
        <div class="terminal-line"><span></span> SYSTEM IS FORMING_</div>
      </aside>
    </div>
    <div class="hero-footnote">
      <span>SCROLL TO TRACE THE PROCESS</span>
      <span aria-hidden="true">↓</span>
    </div>
  </section>

  <section class="section status-section shell" aria-labelledby="status-title">
    <SectionHeading eyebrow="Current status" title="当前状态" index="01" />
    <div class="status-board">
      <div class="status-primary">
        <div class="status-label"><span class="signal-dot"></span> 状态</div>
        <h3 id="status-title">正在构建</h3>
        <p>高中系统之外，<br />真实世界入口。</p>
      </div>
      <div class="status-list">
        <h3>当前重点 / FOCUS</h3>
        <ol>
          <li><span>01</span>学习如何真正使用 AI</li>
          <li><span>02</span>建立自己的内容与记录系统</li>
          <li><span>03</span>探索全球互联网和 Web3</li>
          <li><span>04</span>形成第一个可验证的商业闭环</li>
        </ol>
      </div>
      <div class="status-principles">
        <h3>当前原则 / PRINCIPLES</h3>
        <ul>
          <li>先行动，再优化</li>
          <li>不维护“认知很高”的人设</li>
          <li>记录真实结果，而不是宏大想法</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section intro-section shell">
    <SectionHeading eyebrow="Who am I" title="我是谁" index="02" />
    <div class="intro-grid">
      <p class="pull-quote">我不是 AI 专家，<br />也没有成熟的商业成绩。</p>
      <div class="reading-copy">
        <p>我只是比过去的自己更早开始记录、试错，并主动接触真实世界。</p>
        <p>高三期间，我通过自学、AI 和复盘搭建过自己的学习系统。高考结束后，我开始研究一个更大的问题：</p>
        <p class="question-line">一个年轻人，如何在 AI 时代建立自己的能力系统？</p>
        <p>学校更多教会我们如何考试，却很少告诉我们，毕业之后如何进入真实世界。所以我决定公开记录自己的学习、选择、错误、行动和修正。</p>
        <a class="text-link" href="/about/">继续了解我 →</a>
      </div>
    </div>
  </section>

  <section class="section directions-section shell">
    <SectionHeading eyebrow="Exploration fields" title="三个探索方向" index="03" description="不是成熟业务，是正在发生的探索。" />
    <div class="direction-grid">
      {directions.map((direction) => (
        <article class="direction-card">
          <span>{direction.index}</span>
          <h3>{direction.title}</h3>
          <p>{direction.copy}</p>
          <small>EXPLORING / 未完成</small>
        </article>
      ))}
    </div>
  </section>

  <section class="section writing-section shell">
    <SectionHeading eyebrow="Selected writing" title="精选内容" index="04" description="文章在原始发布平台保留完整上下文。" />
    <div class="article-grid featured-grid">
      {featured.map((article) => (
        <ArticleCard
          title={article.title}
          description={article.description}
          platform={platformLabels[article.platform]}
          category={article.category}
          href={article.externalUrl || undefined}
          external={true}
          publishDate={article.publishDate}
          tags={article.tags}
          featured={article.featured}
        />
      ))}
    </div>
    <div class="section-action"><a class="button" href="/writing/">查看全部文章 <span aria-hidden="true">→</span></a></div>
  </section>

  <section class="section experiments-section shell" id="experiments">
    <SectionHeading eyebrow="Experiments" title="当前实验" index="05" description="不使用虚假进度，只记录真实状态。" />
    <div class="experiment-list">
      {experiments.map((experiment, index) => (
        <article class="experiment-row">
          <span class="experiment-index">0{index + 1}</span>
          <div>
            <h3>{experiment.title}</h3>
            <p>{experiment.copy}</p>
          </div>
          <span class:list={["status-pill", experiment.tone]}>{experiment.status}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="section manifesto-section shell">
    <div class="manifesto-label"><span>PUBLIC NOTE / 001</span><span>诚实比人设重要</span></div>
    <div class="manifesto-grid">
      <h2>我不想维护一个<br /><mark>“18岁认知很高”</mark><br />的人设</h2>
      <div class="reading-copy">
        <p>最近有人说，我18岁就有这样的认知，以后一定会成功。但我没有答案，也没有足够的现实成绩。</p>
        <p>表达得像明白了，和现实中真正做到，是两回事。我不想为了维护一个早熟、正确或者聪明的人设，开始输出自己还没有验证过的结论。</p>
        <p>接下来，我更想记录：我具体做了什么；结果如何；哪里判断错了；下一次怎样修正。</p>
        <p class="question-line">18岁真正的优势，是可以用更低的成本行动、失败、复盘，再重新开始。</p>
        <p>比起成为一个看起来很早熟的人，我更希望成为一个不断产生行动证据的人。</p>
      </div>
    </div>
  </section>

  <section class="section future-section shell">
    <div class="future-copy">
      <p class="eyebrow">Next few years / 接下来几年</p>
      <h2>学习。创造。<br /><mark>连接更大的世界。</mark></h2>
      <p>我的目标，是成为一个能够利用 AI 和互联网解决真实问题、创造真实价值的人。</p>
      <p>我现在没有确定答案。这个网站就是寻找答案的过程。</p>
      <a class="button button-primary" href={siteConfig.social.x} target="_blank" rel="noopener noreferrer">在 X 关注我的公开实验 ↗</a>
    </div>
    <div class="future-code" aria-hidden="true">
      <span>WHILE (NO_ANSWER) {'{'}</span>
      <span>&nbsp;&nbsp;LEARN();</span>
      <span>&nbsp;&nbsp;BUILD();</span>
      <span>&nbsp;&nbsp;REFLECT();</span>
      <span>{'}'}</span>
    </div>
  </section>
</BaseLayout>
