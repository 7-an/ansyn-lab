---
import { siteConfig } from "../config/site";
import { externalWriting } from "../data/external-writing";
import BaseLayout from "../layouts/BaseLayout.astro";

const selectedNotes = externalWriting
  .filter((article) => article.featured && article.externalUrl)
  .slice(0, 3);

const selectedWork = [
  {
    index: "01",
    type: "OPEN SOURCE / COMPLETED",
    title: "AI Study Path Triage",
    description: "从真实学生咨询、7 天实验与复盘中，整理出一套高中学习路径初筛框架，并公开到 GitHub。",
    href: "https://github.com/7-an/ai-study-path-triage",
    external: true
  },
  {
    index: "02",
    type: "PERSONAL LAB / LIVE",
    title: "Ansyn Lab",
    description: "不是完成版简历，而是一座持续记录行动、错误、项目和修正的个人母站。",
    href: "/about/",
    external: false
  },
  {
    index: "03",
    type: "WORK AT KOSX / BUILDING",
    title: "在真实协作中接受检验",
    description: "参与社群项目工作台、内容传播、AI 自动化与网站交付，把学习放进真实需求里。",
    href: siteConfig.kosx.url,
    external: true
  }
] as const;

const coordinates = [
  ["BUILD", "用 AI 与公开互联网完成真实项目"],
  ["WRITE", "记录行动、判断、错误与修正"],
  ["EXPLORE", "从高中系统进入真实协作网络"]
] as const;
---

<BaseLayout>
  <section class="home-hero shell" aria-labelledby="home-title">
    <div class="hero-rail" aria-hidden="true">
      <span>ANSYN LAB / OPEN EXPERIMENT</span>
      <span>FROM SCHOOL SYSTEM TO REAL WORLD</span>
    </div>

    <div class="hero-grid">
      <div class="hero-copy" data-reveal>
        <p class="home-kicker">BUILDING IN PUBLIC / 公开成长实验</p>
        <h1 id="home-title">
          <span>安寻</span>
          <small>Ansyn</small>
        </h1>
        <p class="hero-question">一个年轻人，如何在 AI 时代建立自己的能力系统？</p>
        <p class="hero-summary">从高中系统脱机，进入真实世界。用项目、内容和公开记录，留下正在形成的答案。</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#current">查看当前坐标 <span aria-hidden="true">↓</span></a>
          <a class="button" href="/about/">阅读我的故事 <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <figure class="hero-portrait" data-reveal data-reveal-delay="2">
        <span class="portrait-index" aria-hidden="true">A/01</span>
        <img
          src="/ansyn-avatar-transparent.png"
          alt="安寻的个人形象：戴草帽的黑白漫画头像"
          width="400"
          height="400"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          <span>IDENTITY / STILL FORMING</span>
          <span>NO FINISHED PERSONA</span>
        </figcaption>
      </figure>
    </div>

    <div class="hero-footer" data-reveal data-reveal-delay="3">
      <span>QUESTION → ACTION → EVIDENCE → REVISION</span>
      <span>SCROLL TO EXPLORE&nbsp; ↓</span>
    </div>
  </section>

  <section class="home-section current-section shell" id="current" aria-labelledby="current-title">
    <header class="section-head" data-reveal>
      <div class="section-index">
        <span>01</span>
        <p>CURRENT COORDINATE / 当前坐标</p>
      </div>
      <h2 id="current-title">在真实世界里，<br /><em>边做边校正。</em></h2>
      <span class="section-status">2026—NOW / BUILDING</span>
    </header>

    <div class="current-layout">
      <figure class="field-photo field-photo-primary" data-reveal>
        <div class="photo-frame">
          <img
            src="/images/kosx-field-note.jpg"
            alt="KOSX 线下见面时，三个人在窗前展示各自的 X 主页"
            width="1200"
            height="1594"
            loading="lazy"
          />
          <span class="photo-code" aria-hidden="true">FIELD NOTE / 001</span>
        </div>
        <figcaption><span>KOSX 线下见面</span><span>现场记录 / CURRENT</span></figcaption>
      </figure>

      <div class="current-story">
        <figure class="field-photo field-photo-secondary" data-reveal data-reveal-delay="1">
          <div class="photo-frame">
            <img
              src="/images/kosx-ansyn-lab-sharing.jpg"
              alt="漫画风格的 KOSX 线下会议现场，屏幕上正在展示 Ansyn Lab 首页"
              width="1600"
              height="900"
              loading="lazy"
            />
            <span class="photo-code" aria-hidden="true">EVIDENCE / 002</span>
          </div>
          <figcaption><span>分享 Ansyn Lab</span><span>真实协作 / EVIDENCE</span></figcaption>
        </figure>

        <div class="coordinate-copy" data-reveal data-reveal-delay="2">
          <div class="coordinate-heading">
            <span class="coordinate-mark">K/</span>
            <div>
              <p>WORK AT KOSX / 当前组织</p>
              <h3>KOSX.ai</h3>
            </div>
          </div>
          <p class="coordinate-intro">我目前以实习成员身份参与 KOSX 的早期建设。这里不是我的身份标签，而是我第一次把学习放进真实项目、协作与反馈里接受检验的地方。</p>
          <ol class="coordinate-list">
            {coordinates.map(([label, text], index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")} / {label}</span>
                <strong>{text}</strong>
              </li>
            ))}
          </ol>
          <a class="inline-link" href={siteConfig.kosx.url} target="_blank" rel="noopener noreferrer">了解 KOSX <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section work-section shell" id="work" aria-labelledby="work-title">
    <header class="section-head compact" data-reveal>
      <div class="section-index">
        <span>02</span>
        <p>SELECTED WORK / 精选行动</p>
      </div>
      <h2 id="work-title">先做出来，<br /><em>再交给现实评价。</em></h2>
      <a class="section-link" href="/work/">全部项目 <span aria-hidden="true">→</span></a>
    </header>

    <div class="work-rows">
      {selectedWork.map((project, index) => (
        <a
          class="work-row"
          href={project.href}
          target={project.external ? "_blank" : undefined}
          rel={project.external ? "noopener noreferrer" : undefined}
          data-reveal
          data-reveal-delay={String(index + 1)}
        >
          <span class="work-index">{project.index}</span>
          <div class="work-title-group">
            <span>{project.type}</span>
            <h3>{project.title}</h3>
          </div>
          <p>{project.description}</p>
          <span class="work-arrow" aria-hidden="true">{project.external ? "↗" : "→"}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section notes-section shell" aria-labelledby="notes-title">
    <header class="section-head compact" data-reveal>
      <div class="section-index">
        <span>03</span>
        <p>LATEST NOTES / 最近记录</p>
      </div>
      <h2 id="notes-title">把判断写下来，<br /><em>等待现实修正。</em></h2>
      <a class="section-link" href="/writing/">全部内容 <span aria-hidden="true">→</span></a>
    </header>

    <div class="note-list">
      {selectedNotes.map((note, index) => (
        <a
          class="note-row"
          href={note.externalUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
          data-reveal-delay={String(index + 1)}
        >
          <span class="note-number">0{index + 1}</span>
          <div>
            <span class="note-meta">{note.platform} / {note.category}</span>
            <h3>{note.title}</h3>
          </div>
          <span class="note-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section public-section shell" aria-labelledby="public-title">
    <div class="public-grid" data-reveal>
      <div class="section-index">
        <span>04</span>
        <p>WHY PUBLIC / 为什么公开</p>
      </div>
      <div>
        <h2 id="public-title">没有完成的人设，<br />只有正在形成的答案。</h2>
        <p>在高中，问题是老师给的；进入真实世界后，问题和需求都要自己寻找。公开记录既是一份赛博日记，也是我留下行动证据、看见自己如何变化的方式。</p>
        <div class="public-method" aria-label="公开实验方法">
          <span>问题</span><i>→</i><span>行动</span><i>→</i><span>证据</span><i>→</i><span>修正</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-kicker,
  .section-index,
  .section-status,
  .photo-code,
  .field-photo figcaption,
  .coordinate-heading p,
  .work-title-group > span,
  .work-index,
  .note-meta,
  .note-number,
  .public-method {
    font-family: var(--mono);
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .home-hero,
  .home-section { border-inline: 1px solid var(--line); }

  .home-hero {
    min-height: calc(100svh - 72px);
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--ink);
  }

  .hero-rail,
  .hero-footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    color: var(--muted);
    font: 650 .65rem/1.4 var(--mono);
    letter-spacing: .08em;
  }

  .hero-rail { padding: 18px clamp(20px, 4vw, 54px); border-bottom: 1px solid var(--line); }
  .hero-footer { padding: 20px clamp(20px, 4vw, 54px); border-top: 1px solid var(--line); }

  .hero-grid {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(330px, .92fr);
    align-items: center;
    gap: clamp(42px, 7vw, 110px);
    padding: clamp(62px, 8vw, 110px) clamp(22px, 5vw, 70px);
  }

  .home-kicker { margin: 0; color: var(--accent-strong); font-size: .72rem; font-weight: 760; }

  .hero-copy h1 {
    display: flex;
    align-items: baseline;
    gap: .16em;
    margin: 26px 0 0;
    font-size: clamp(5rem, 9vw, 8.6rem);
    font-weight: 900;
    line-height: .84;
    letter-spacing: -.085em;
    white-space: nowrap;
  }

  .hero-copy h1 small { font-size: .45em; font-weight: 780; letter-spacing: -.055em; }

  .hero-question {
    max-width: 660px;
    margin: 38px 0 0;
    font-size: clamp(1.45rem, 2.45vw, 2.1rem);
    font-weight: 730;
    line-height: 1.42;
    letter-spacing: -.04em;
    text-wrap: balance;
  }

  .hero-summary { max-width: 590px; margin: 18px 0 0; color: var(--muted); font-size: .98rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }

  .hero-portrait {
    position: relative;
    width: min(100%, 500px);
    margin: 0 auto;
    padding: clamp(20px, 3vw, 36px);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--white) 68%, transparent);
    isolation: isolate;
  }

  .hero-portrait::before,
  .hero-portrait::after { content: ""; position: absolute; z-index: -1; background: var(--accent); }
  .hero-portrait::before { top: -1px; left: 18%; width: 22%; height: 3px; }
  .hero-portrait::after { right: -1px; bottom: 18%; width: 3px; height: 22%; }

  .hero-portrait img {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(1) contrast(1.02);
    mix-blend-mode: multiply;
  }

  .portrait-index { position: absolute; top: 16px; right: 18px; color: var(--accent-strong); font: 760 .68rem var(--mono); }

  .hero-portrait figcaption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font: 640 .62rem var(--mono);
  }

  .home-section {
    padding: clamp(92px, 11vw, 148px) clamp(22px, 5vw, 70px);
    border-bottom: 1px solid var(--ink);
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(170px, .55fr) minmax(0, 1.45fr) auto;
    align-items: end;
    gap: 40px;
    padding-bottom: clamp(34px, 4vw, 52px);
    border-bottom: 1px solid var(--ink);
  }

  .section-head h2,
  .public-grid h2 {
    margin: 0;
    font-size: clamp(3rem, 5.9vw, 5.7rem);
    line-height: .98;
    letter-spacing: -.068em;
  }

  .section-head h2 em { color: var(--accent-strong); font-style: normal; }
  .section-index { display: flex; align-items: center; gap: 16px; align-self: start; }
  .section-index > span { color: var(--accent-strong); font-size: .82rem; font-weight: 800; }
  .section-index p { margin: 0; color: var(--muted); font-size: .68rem; font-weight: 700; }
  .section-status { color: var(--accent-strong); font-size: .7rem; font-weight: 750; white-space: nowrap; }
  .section-link { align-self: end; color: var(--accent-strong); font: 760 .78rem var(--mono); border-bottom: 1px solid currentColor; }

  .current-layout {
    display: grid;
    grid-template-columns: minmax(300px, .82fr) minmax(0, 1.18fr);
    gap: clamp(32px, 5vw, 70px);
    margin-top: clamp(42px, 6vw, 78px);
  }

  .field-photo { margin: 0; }
  .photo-frame { position: relative; overflow: hidden; background: var(--paper-deep); }
  .photo-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(145deg, rgba(53, 107, 255, .08), transparent 44%);
    mix-blend-mode: multiply;
  }

  .field-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .8s cubic-bezier(.22, 1, .36, 1), filter .5s ease;
  }
  .field-photo:hover img { transform: scale(1.025); filter: saturate(.9) contrast(1.03); }
  .field-photo-primary .photo-frame { aspect-ratio: 4 / 5; }
  .field-photo-primary img { object-position: center 44%; }
  .field-photo-secondary .photo-frame { aspect-ratio: 16 / 9; }

  .photo-code {
    position: absolute;
    z-index: 2;
    top: 14px;
    left: 14px;
    padding: 7px 9px;
    background: rgba(21, 23, 26, .88);
    color: var(--white);
    font-size: .62rem;
  }

  .field-photo figcaption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 12px;
    color: var(--muted);
    font-size: .62rem;
  }

  .current-story { display: flex; flex-direction: column; gap: clamp(42px, 5vw, 64px); }
  .coordinate-copy { border-top: 1px solid var(--ink); padding-top: 30px; }
  .coordinate-heading { display: flex; align-items: center; gap: 18px; }
  .coordinate-mark {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    background: var(--accent);
    color: var(--ink);
    font-size: 1.1rem;
    font-weight: 900;
  }
  .coordinate-heading p { margin: 0; color: var(--accent-strong); font-size: .66rem; font-weight: 760; }
  .coordinate-heading h3 { margin: 4px 0 0; font-size: 2rem; letter-spacing: -.05em; }
  .coordinate-intro { max-width: 690px; margin: 26px 0 0; font-size: 1.08rem; font-weight: 620; }

  .coordinate-list { margin: 32px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .coordinate-list li {
    display: grid;
    grid-template-columns: 155px 1fr;
    gap: 20px;
    padding: 17px 0;
    border-bottom: 1px solid var(--line);
  }
  .coordinate-list span { color: var(--accent-strong); font: 720 .64rem var(--mono); }
  .coordinate-list strong { font-size: .92rem; font-weight: 660; }
  .inline-link { display: inline-flex; gap: 8px; margin-top: 28px; color: var(--accent-strong); font-weight: 800; border-bottom: 1px solid currentColor; }

  .work-rows,
  .note-list { border-top: 1px solid var(--ink); margin-top: clamp(46px, 6vw, 76px); }

  .work-row {
    display: grid;
    grid-template-columns: 72px minmax(270px, .9fr) minmax(300px, 1.1fr) 36px;
    align-items: center;
    gap: 30px;
    min-height: 190px;
    padding: 30px 18px 30px 0;
    border-bottom: 1px solid var(--line);
    transition: background .25s ease, padding .35s cubic-bezier(.22, 1, .36, 1);
  }
  .work-row:hover { padding-left: 18px; background: color-mix(in srgb, var(--accent-soft) 38%, transparent); }
  .work-index { color: var(--accent-strong); font-size: .74rem; font-weight: 780; }
  .work-title-group > span { color: var(--muted); font-size: .64rem; font-weight: 720; }
  .work-title-group h3 { margin: 13px 0 0; font-size: clamp(1.65rem, 2.8vw, 2.55rem); line-height: 1.12; letter-spacing: -.045em; }
  .work-row > p { margin: 0; color: var(--muted); }
  .work-arrow,
  .note-arrow { color: var(--accent-strong); font-size: 1.35rem; transition: transform .25s ease; }
  .work-row:hover .work-arrow,
  .note-row:hover .note-arrow { transform: translate(4px, -4px); }

  .note-row {
    display: grid;
    grid-template-columns: 72px 1fr 36px;
    align-items: center;
    gap: 30px;
    min-height: 148px;
    padding: 24px 18px 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .note-number { color: var(--accent-strong); font-size: .72rem; font-weight: 780; }
  .note-meta { color: var(--muted); font-size: .62rem; font-weight: 720; }
  .note-row h3 {
    max-width: 900px;
    margin: 10px 0 0;
    font-size: clamp(1.3rem, 2.3vw, 2rem);
    line-height: 1.3;
    letter-spacing: -.035em;
    transition: color .2s ease;
  }
  .note-row:hover h3 { color: var(--accent-strong); }

  .public-section { background: var(--ink); color: var(--paper); }
  .public-grid { display: grid; grid-template-columns: minmax(170px, .55fr) minmax(0, 1.45fr); gap: 40px; }
  .public-grid .section-index p { color: #969991; }
  .public-grid h2 { max-width: 900px; }
  .public-grid > div:last-child > p { max-width: 760px; margin: 34px 0 0; color: #b9bbb4; font-size: 1.08rem; }
  .public-method { display: flex; flex-wrap: wrap; align-items: center; gap: 13px; margin-top: 42px; color: #8faaff; font-size: .72rem; font-weight: 760; }
  .public-method i { color: #6d706a; font-style: normal; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr .7fr; gap: 28px; }
    .hero-copy h1 { font-size: clamp(4.6rem, 11vw, 6.4rem); }
    .section-head { grid-template-columns: 1fr; align-items: start; gap: 26px; }
    .section-link,
    .section-status { justify-self: start; }
    .current-layout { grid-template-columns: .78fr 1.22fr; gap: 28px; }
    .work-row { grid-template-columns: 58px 1fr 34px; }
    .work-row > p { grid-column: 2; }
    .work-arrow { grid-column: 3; grid-row: 1 / span 2; }
  }

  @media (max-width: 700px) {
    .home-hero,
    .home-section { border-inline: 0; }
    .home-hero { min-height: auto; }
    .hero-rail { display: none; }
    .hero-grid { grid-template-columns: 1fr; padding: 68px 18px 38px; }
    .hero-copy h1 { flex-wrap: wrap; font-size: clamp(4.5rem, 22vw, 6.4rem); white-space: normal; }
    .hero-copy h1 small { font-size: .39em; }
    .hero-question { margin-top: 30px; }
    .hero-actions { flex-direction: column; }
    .hero-actions .button { width: 100%; }
    .hero-portrait { width: min(92%, 420px); margin-top: 14px; }
    .hero-portrait figcaption { flex-direction: column; gap: 4px; }
    .hero-footer { flex-direction: column; gap: 6px; }
    .home-section { padding-inline: 18px; }
    .section-head h2,
    .public-grid h2 { font-size: clamp(2.8rem, 14.5vw, 4.4rem); }
    .current-layout { grid-template-columns: 1fr; }
    .field-photo-primary .photo-frame { aspect-ratio: 4 / 4.6; }
    .current-story { gap: 44px; }
    .coordinate-list li { grid-template-columns: 1fr; gap: 8px; }
    .work-row { grid-template-columns: 42px 1fr 26px; gap: 16px; min-height: 170px; padding-right: 0; }
    .work-row:hover { padding-left: 0; }
    .work-row > p { font-size: .9rem; }
    .note-row { grid-template-columns: 38px 1fr 22px; gap: 14px; padding-right: 0; }
    .public-grid { grid-template-columns: 1fr; gap: 42px; }
  }
</style>
