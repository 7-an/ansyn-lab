---
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const coordinates = [
  "用 AI 工作流，做真实项目与交付",
  "建立公开记录与内容系统",
  "探索全球互联网与 Web3"
];
---

<BaseLayout>
  <section class="lab-hero shell" aria-labelledby="home-title">
    <div class="lab-hero-copy" data-reveal data-reveal-delay="1">
      <p class="lab-kicker">BUILDING IN PUBLIC / SINCE 18</p>
      <h1 id="home-title" data-proximity><span class="lm"><span class="lm-in">安寻 <span class="latin">Ansyn</span></span></span></h1>
      <p class="lab-question"><span class="lm"><span class="lm-in">一个年轻人，如何在 AI 时代建立自己的能力系统？</span></span></p>
      <p class="lab-note">AI Workflow Builder · 现于 KOSX.ai 实习</p>
      <div class="lab-actions">
        <a class="button button-primary" href="/about/">阅读我的故事 <span aria-hidden="true">→</span></a>
        <a class="button" href="#guide">查看精选内容</a>
      </div>
      <div class="lab-contact-links">
        <a class="lab-text-link" href={siteConfig.social.x} target="_blank" rel="noopener noreferrer">在 X 联系我 ↗</a>
        <a class="lab-text-link" href={siteConfig.social.telegram} target="_blank" rel="noopener noreferrer">Telegram ↗</a>
      </div>
    </div>

    <figure class="lab-portrait" data-reveal data-reveal-delay="2" data-particle-portrait>
      <div class="particle-stage">
        <canvas class="particle-canvas" aria-hidden="true"></canvas>
        <img
          src="/ansyn-avatar-transparent.png"
          alt="安寻的个人形象：戴草帽的黑白漫画头像"
          width="400"
          height="400"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </figure>
  </section>

  <section class="home-section affiliation shell" aria-labelledby="affiliation-title">
    <header class="home-heading" data-reveal>
      <div>
        <p class="lab-kicker">CURRENT AFFILIATION / 当前组织</p>
        <h2 id="affiliation-title"><img class="affiliation-logo" src="/kosx-logo-black.png" alt="KOSX.ai" width="2350" height="397" /></h2>
      </div>
      <span class="home-status">INTERNSHIP / BUILDING</span>
    </header>

    <div class="affiliation-card" data-reveal data-reveal-delay="1">
      <div class="affiliation-main">
        <p class="affiliation-tagline">将 AI 时代的创造者，组织成真正能够把事情做成的网络。</p>
        <p class="affiliation-intro">我目前作为实习成员参与 KOSX 的早期建设：把群聊中的信息、人才与机会，转化为可以被追踪和交付的真实项目。这里是我现在接受真实项目检验的地方。</p>
        <p class="affiliation-slogan">CONNECT. CREATE. COLLABORATE.</p>
      </div>
      <div class="affiliation-side">
        <p class="affiliation-side-label">当前参与方向</p>
        <ul>
          <li>社群活动与项目管理工作台</li>
          <li>AI 工作流与自动化节点</li>
          <li>群内日报的内容二创与外部传播</li>
          <li>AI 辅助网站与基础产品交付</li>
        </ul>
        <a class="affiliation-link" href={siteConfig.kosx.url} target="_blank" rel="noopener noreferrer">了解 KOSX ↗</a>
      </div>
    </div>
  </section>

  <section class="home-section home-now shell" id="now" aria-labelledby="now-title">
    <header class="home-heading" data-reveal>
      <div>
        <p class="lab-kicker">NOW / CURRENT COORDINATES</p>
        <h2 id="now-title" data-proximity><span class="lm"><span class="lm-in">当前坐标</span></span></h2>
      </div>
      <span class="home-status">BUILDING / 2026—NOW</span>
    </header>

    <ol class="coordinate-list" data-reveal data-reveal-delay="1">
      {coordinates.map((item, index) => (
        <li>
          <span>00{index + 1}</span>
          <strong>{item}</strong>
        </li>
      ))}
    </ol>

    <div class="method-line" data-reveal data-reveal-delay="2">
      <span>METHOD / 反复校正</span>
      <strong>问题 <i>→</i> 行动 <i>→</i> 证据 <i>→</i> 修正</strong>
    </div>

    <div class="why-public-line" data-reveal data-reveal-delay="3">
      <span>WHY PUBLIC / 为什么公开</span>
      <p>在高中，问题是老师给的；进入真实世界后，问题和需求都要自己寻找。<br />公开记录，既是我寻找问题的方式，也是我留下的行动证据。</p>
    </div>
  </section>

  <section class="home-section home-guide shell" id="guide" aria-label="前往项目与文章页面">
    <div class="guide-grid">
      <a class="guide-card" href="/work/" data-reveal>
        <span>PROJECTS / 项目与交付</span>
        <h3>项目</h3>
        <p>独立项目与组织协作，每张卡写清角色、交付和下一步。</p>
        <i aria-hidden="true">→</i>
      </a>
      <a class="guide-card" href="/writing/" data-reveal data-reveal-delay="1">
        <span>WRITING / 公开内容</span>
        <h3>文章</h3>
        <p>发布在 X 等外部平台的思考与复盘，点击前往原文。</p>
        <i aria-hidden="true">→</i>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .lab-kicker {
    margin: 0;
    color: var(--accent-strong);
    font: 750 .74rem/1.4 var(--mono);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .lab-hero {
    min-height: calc(100svh - 72px);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr);
    align-items: center;
    gap: clamp(32px, 7vw, 110px);
    padding-block: clamp(76px, 10vw, 132px);
    border-inline: 1px solid var(--line);
    overflow: hidden;
  }

  .lab-hero-copy {
    z-index: 1;
    padding-left: clamp(22px, 5vw, 74px);
  }

  .lab-hero h1 {
    display: flex;
    align-items: baseline;
    gap: .14em;
    margin: 30px 0 0;
    font-size: clamp(4.6rem, 8.4vw, 8.2rem);
    font-weight: 900;
    line-height: .9;
    letter-spacing: -.08em;
    white-space: nowrap;
  }

  .lab-hero h1 .latin {
    font-size: .55em;
    font-weight: 790;
    letter-spacing: -.05em;
  }

  .lab-question {
    max-width: 690px;
    margin: 34px 0 0;
    font-size: clamp(1.45rem, 2.5vw, 2.15rem);
    font-weight: 720;
    line-height: 1.42;
    letter-spacing: -.035em;
    text-wrap: balance;
  }

  .lab-note {
    margin: 14px 0 0;
    color: var(--muted);
    font-size: .92rem;
  }

  .lab-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .lab-contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 26px;
  }

  .lab-text-link {
    display: inline-flex;
    color: var(--accent-strong);
    font-weight: 800;
    border-bottom: 1px solid currentColor;
  }

  .lab-text-link:hover { color: var(--ink); }

  .lab-portrait {
    align-self: center;
    margin: 0;
    padding-right: clamp(18px, 4vw, 58px);
  }

  .particle-stage {
    position: relative;
    width: min(100%, 540px);
    aspect-ratio: 1;
    margin-inline: auto;
    isolation: isolate;
  }

  .particle-stage img,
  .particle-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .particle-stage img {
    object-fit: contain;
    filter: grayscale(1) contrast(1.08);
    mix-blend-mode: multiply;
    transition: opacity .38s ease, filter .38s ease;
  }

  .particle-canvas {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity .58s ease;
  }

  :global([data-particle-portrait].particle-ready) .particle-stage img { opacity: 0; }
  :global([data-particle-portrait].particle-ready) .particle-canvas { opacity: 1; }
  :global([data-particle-portrait].particle-base-visible) .particle-stage img {
    opacity: 1;
    filter: grayscale(1) contrast(1.08);
  }
  :global([data-particle-portrait].particle-settled) .particle-canvas { opacity: .14; }

  .lab-portrait img {
    display: block;
    width: min(100%, 540px);
    height: auto;
    margin-inline: auto;
    filter: grayscale(1) contrast(1.08);
    mix-blend-mode: multiply;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0, #000 4%, #000 96%, transparent 100%),
      linear-gradient(to bottom, transparent 0, #000 4%, #000 84%, transparent 99%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0, #000 4%, #000 96%, transparent 100%),
      linear-gradient(to bottom, transparent 0, #000 4%, #000 84%, transparent 99%);
    mask-composite: intersect;
  }

  .home-section { padding-block: clamp(92px, 11vw, 148px); }

  .home-heading {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 42px;
    padding-bottom: 44px;
    border-bottom: 1px solid var(--ink);
  }

  .js .home-heading { border-bottom-color: transparent; }

  .home-heading::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1s cubic-bezier(.22, 1, .36, 1) .18s;
  }

  .home-heading.is-revealed::after { transform: scaleX(1); }

  .js .lm-in {
    transform: translateY(112%);
    transition: transform .9s cubic-bezier(.22, 1, .36, 1);
  }

  .is-revealed .lm-in { transform: none; }

  .js .lab-question .lm-in { transition-delay: .15s; }

  .lab-hero h1 .lm {
    padding-bottom: .12em;
    margin-bottom: -.12em;
  }

  .home-heading h2 {
    margin: 22px 0 0;
    font-size: clamp(3.4rem, 6.6vw, 6.4rem);
    line-height: .92;
    letter-spacing: -.07em;
  }

  .home-status {
    color: var(--accent-strong);
    font: 750 .75rem var(--mono);
    letter-spacing: .06em;
  }

  .affiliation {
    --kx: #ff6a00;
    --kx-strong: #d9480f;
    --kx-soft: #ff8347;
  }

  .affiliation .lab-kicker,
  .affiliation .home-status { color: var(--kx-strong); }

  .affiliation h2 { margin: 22px 0 0; }

  .affiliation-logo {
    display: block;
    width: auto;
    height: clamp(52px, 6.5vw, 88px);
  }

  .affiliation-card {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    margin-top: clamp(36px, 5vw, 56px);
    padding: clamp(28px, 4vw, 52px);
    background: var(--ink);
    color: var(--paper);
    box-shadow: 10px 10px 0 var(--kx);
  }

  .affiliation-tagline {
    max-width: 560px;
    margin: 0;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -.02em;
  }

  .affiliation-intro {
    max-width: 560px;
    margin: 20px 0 0;
    color: #b9bbb4;
    font-size: .98rem;
  }

  .affiliation-slogan {
    margin: 28px 0 0;
    color: var(--kx);
    font: 750 .74rem var(--mono);
    letter-spacing: .14em;
  }

  .affiliation-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding-left: clamp(24px, 3vw, 48px);
    border-left: 1px solid #4d4f4a;
  }

  .affiliation-side-label {
    margin: 0;
    color: var(--kx-soft);
    font: 750 .72rem var(--mono);
    letter-spacing: .06em;
  }

  .affiliation-side ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: #d3d4cf;
    font-size: .95rem;
  }

  .affiliation-side li { padding-left: 16px; border-left: 1px solid var(--kx); }

  .affiliation-link {
    margin-top: auto;
    color: var(--kx-soft);
    font: 800 .85rem var(--mono);
    border-bottom: 1px solid currentColor;
  }

  .affiliation-link:hover { color: var(--paper); }

  .affiliation-card {
    position: relative;
    overflow: hidden;
  }

  .affiliation-card::before {
    content: "";
    position: absolute;
    inset: -35%;
    pointer-events: none;
    background:
      radial-gradient(ellipse 42% 52% at 32% 38%, rgba(53, 107, 255, .16), transparent 62%),
      radial-gradient(ellipse 38% 48% at 68% 62%, rgba(53, 107, 255, .1), transparent 60%);
    animation: affiliation-mist 18s ease-in-out infinite alternate;
  }

  .affiliation-main,
  .affiliation-side {
    position: relative;
    z-index: 1;
  }

  @keyframes affiliation-mist {
    from { transform: translate3d(-3.5%, -2.5%, 0) rotate(-1.6deg); }
    to { transform: translate3d(3.5%, 2.5%, 0) rotate(1.6deg) scale(1.05); }
  }

  .js .affiliation-card[data-reveal] {
    opacity: 0;
    transform: translateY(14px) scale(.97);
    filter: blur(14px);
    box-shadow: 0 0 0 var(--kx);
    transition:
      opacity 1.05s ease,
      transform 1.05s cubic-bezier(.22, 1, .36, 1),
      filter 1.05s ease,
      box-shadow .9s ease .15s;
  }

  .js .affiliation-card[data-reveal].is-revealed {
    opacity: 1;
    transform: none;
    filter: blur(0);
    box-shadow: 10px 10px 0 var(--kx);
  }

  .coordinate-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .coordinate-list li {
    display: grid;
    grid-template-columns: 180px 1fr;
    align-items: center;
    min-height: 112px;
    border-bottom: 1px solid var(--line);
  }

  .coordinate-list li > span {
    color: var(--accent-strong);
    font: 750 .8rem var(--mono);
  }

  .coordinate-list strong {
    position: relative;
    padding-left: 70px;
    font-size: clamp(1.4rem, 2.5vw, 2.25rem);
    letter-spacing: -.035em;
  }

  .coordinate-list strong::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 1px;
    height: 48px;
    background: var(--accent);
    transform: translateY(-50%);
  }

  .method-line {
    display: flex;
    align-items: center;
    gap: 42px;
    padding: 32px 0;
    border-bottom: 1px solid var(--ink);
  }

  .method-line span {
    color: var(--accent-strong);
    font: 750 .74rem var(--mono);
  }

  .method-line strong { font: 650 1rem var(--mono); }
  .method-line i { padding-inline: 10px; color: var(--muted); font-style: normal; }

  .why-public-line {
    display: flex;
    align-items: baseline;
    gap: 42px;
    padding-top: 44px;
  }

  .why-public-line span {
    flex: 0 0 auto;
    color: var(--accent-strong);
    font: 750 .74rem var(--mono);
    letter-spacing: .06em;
  }

  .why-public-line p {
    max-width: 780px;
    margin: 0;
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    font-weight: 650;
    line-height: 1.6;
    letter-spacing: -.02em;
  }

  .home-guide { padding-bottom: clamp(116px, 13vw, 180px); }

  .guide-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--ink);
  }

  .guide-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 280px;
    padding: clamp(26px, 3.5vw, 44px);
    transition: background .18s ease, color .18s ease;
  }

  .guide-card + .guide-card { border-left: 1px solid var(--ink); }

  .guide-card span {
    color: var(--accent-strong);
    font: 750 .74rem var(--mono);
    letter-spacing: .08em;
    transition: color .18s ease;
  }

  .guide-card h3 {
    margin: 26px 0 14px;
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    letter-spacing: -.05em;
    transition: color .18s ease;
  }

  .guide-card p {
    max-width: 420px;
    margin: 0;
    color: var(--muted);
    transition: color .18s ease;
  }

  .guide-card i {
    margin-top: auto;
    padding-top: 30px;
    font-style: normal;
    font-size: 1.6rem;
    transition: transform .18s ease;
  }

  .guide-card:hover { background: var(--ink); color: var(--paper); }
  .guide-card:hover span { color: #7fa0ff; }
  .guide-card:hover p { color: #b9bbb4; }
  .guide-card:hover i { transform: translateX(8px); }

  @media (max-width: 900px) {
    .lab-hero {
      min-height: auto;
      grid-template-columns: 1fr .72fr;
      gap: 20px;
      padding-block: 84px;
    }
    .lab-hero h1 { font-size: clamp(4rem, 10vw, 6rem); }
    .coordinate-list li { grid-template-columns: 110px 1fr; }
    .coordinate-list strong { padding-left: 42px; }
  }

  @media (max-width: 700px) {
    .lab-hero {
      grid-template-columns: 1fr;
      padding: 68px 18px 36px;
      border-inline: 0;
    }
    .lab-hero-copy { padding: 0; }
    .lab-hero h1 { flex-wrap: wrap; font-size: clamp(4.2rem, 20vw, 6.4rem); white-space: normal; }
    .lab-hero h1 .latin { font-size: .43em; }
    .lab-actions { align-items: stretch; flex-direction: column; }
    .lab-actions .button { width: 100%; }
    .lab-contact-links { flex-direction: column; gap: 10px; }
    .lab-portrait { padding: 20px 10px 0; }
    .lab-portrait img { width: 100%; }
    .home-heading { align-items: flex-start; flex-direction: column; gap: 24px; }
    .home-heading h2 { font-size: clamp(3.4rem, 17vw, 5rem); }
    .affiliation-card { grid-template-columns: 1fr; box-shadow: 7px 7px 0 var(--kx); }
    .js .affiliation-card[data-reveal].is-revealed { box-shadow: 7px 7px 0 var(--kx); }
    .affiliation-side {
      margin-top: 28px;
      padding: 24px 0 0;
      border-top: 1px solid #4d4f4a;
      border-left: 0;
    }
    .coordinate-list li { grid-template-columns: 54px 1fr; min-height: 94px; }
    .coordinate-list strong { padding-left: 22px; font-size: 1.25rem; }
    .coordinate-list strong::before { height: 34px; }
    .method-line { align-items: flex-start; flex-direction: column; gap: 16px; }
    .method-line strong { font-size: .82rem; line-height: 2.2; }
    .method-line i { padding-inline: 4px; }
    .why-public-line { flex-direction: column; gap: 14px; }
    .guide-grid { grid-template-columns: 1fr; }
    .guide-card { min-height: 220px; }
    .guide-card + .guide-card { border-top: 1px solid var(--ink); border-left: 0; }
  }

</style>

<script>
  const particlePortrait = document.querySelector<HTMLElement>("[data-particle-portrait]");
  const particleStage = particlePortrait?.querySelector<HTMLElement>(".particle-stage");
  const particleCanvas = particleStage?.querySelector<HTMLCanvasElement>(".particle-canvas");
  const particleImage = particleStage?.querySelector<HTMLImageElement>("img");
  const particleMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  type PortraitParticle = {
    nx: number;
    ny: number;
    tx: number;
    ty: number;
    sx: number;
    sy: number;
    size: number;
    delay: number;
    duration: number;
    phase: number;
  };

  if (particlePortrait && particleStage && particleCanvas && particleImage && !particleMotion.matches) {
    const startParticleReveal = () => {
      if (particlePortrait.dataset.particleStarted === "true") return;

      const firstRect = particleStage.getBoundingClientRect();
      if (firstRect.width < 2 || firstRect.height < 2) {
        window.setTimeout(startParticleReveal, 80);
        return;
      }

      const context = particleCanvas.getContext("2d");
      if (!context) return;
      particlePortrait.dataset.particleStarted = "true";

      const pixelRatio = Math.min(window.devicePixelRatio || 1, 1.6);
      const extensionRatio = firstRect.width < 420 ? .38 : .56;
      let stageWidth = firstRect.width;
      let stageHeight = firstRect.height;
      let extension = stageWidth * extensionRatio;
      let canvasWidth = stageWidth + extension;
      let particles: PortraitParticle[] = [];
      let startedAt = performance.now();
      let frameId = 0;
      let baseVisible = false;
      let settled = false;
      const pointer = { x: -9999, y: -9999, active: false };

      const measure = () => {
        const rect = particleStage.getBoundingClientRect();
        stageWidth = rect.width;
        stageHeight = rect.height;
        extension = stageWidth * extensionRatio;
        canvasWidth = stageWidth + extension;
        particleCanvas.style.left = `${-extension}px`;
        particleCanvas.style.width = `${canvasWidth}px`;
        particleCanvas.style.height = `${stageHeight}px`;
        particleCanvas.width = Math.round(canvasWidth * pixelRatio);
        particleCanvas.height = Math.round(stageHeight * pixelRatio);
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      };

      const layoutParticles = (first = false) => {
        particles.forEach((particle) => {
          particle.tx = extension + particle.nx * stageWidth;
          particle.ty = particle.ny * stageHeight;
          if (!first) return;
          particle.sx = extension * (.04 + Math.random() * .78);
          particle.sy = particle.ty + (Math.random() - .5) * Math.min(170, stageHeight * .42);
        });
      };

      const sampleImage = () => {
        const sampleCanvas = document.createElement("canvas");
        const sampleWidth = Math.min(window.innerWidth < 680 ? 280 : 400, particleImage.naturalWidth);
        const sampleHeight = Math.max(1, Math.round(sampleWidth * particleImage.naturalHeight / particleImage.naturalWidth));
        sampleCanvas.width = sampleWidth;
        sampleCanvas.height = sampleHeight;
        const sampleContext = sampleCanvas.getContext("2d", { willReadFrequently: true });
        if (!sampleContext) return;
        sampleContext.drawImage(particleImage, 0, 0, sampleWidth, sampleHeight);
        const pixels = sampleContext.getImageData(0, 0, sampleWidth, sampleHeight).data;

        let subjectPixels = 0;
        for (let offset = 0; offset < pixels.length; offset += 4) {
          const max = Math.max(pixels[offset], pixels[offset + 1], pixels[offset + 2]);
          const min = Math.min(pixels[offset], pixels[offset + 1], pixels[offset + 2]);
          const isBackground = pixels[offset + 3] < 80 || ((max + min) / 2 > 218 && max - min < 34);
          if (!isBackground) subjectPixels += 1;
        }

        const targetCount = window.innerWidth < 680 ? 8200 : 15000;
        const step = Math.max(1, Math.round(Math.sqrt(subjectPixels / targetCount)));
        const nextParticles: PortraitParticle[] = [];

        for (let y = 0; y < sampleHeight; y += step) {
          for (let x = 0; x < sampleWidth; x += step) {
            const offset = (y * sampleWidth + x) * 4;
            const max = Math.max(pixels[offset], pixels[offset + 1], pixels[offset + 2]);
            const min = Math.min(pixels[offset], pixels[offset + 1], pixels[offset + 2]);
            const isBackground = pixels[offset + 3] < 80 || ((max + min) / 2 > 218 && max - min < 34);
            if (isBackground) continue;
            const nx = x / sampleWidth;
            nextParticles.push({
              nx,
              ny: y / sampleHeight,
              tx: 0,
              ty: 0,
              sx: 0,
              sy: 0,
              size: .82 + Math.random() * 1.02,
              delay: nx * 620 + Math.random() * 230,
              duration: 760 + Math.random() * 520,
              phase: Math.random() * Math.PI * 2
            });
          }
        }

        particles = nextParticles;
        layoutParticles(true);
      };

      const easeOut = (value: number) => 1 - Math.pow(1 - value, 3);
      const settleAt = 1750;
      const revealBaseAt = 1880;
      const softenParticlesAt = 2280;

      const draw = (now: number) => {
        const elapsed = now - startedAt;
        if (!baseVisible && elapsed >= revealBaseAt) {
          particlePortrait.classList.add("particle-base-visible");
          baseVisible = true;
        }
        if (!settled && elapsed >= softenParticlesAt) {
          particlePortrait.classList.add("particle-settled");
          settled = true;
        }

        context.clearRect(0, 0, canvasWidth, stageHeight);
        const time = now * .001;

        particles.forEach((particle) => {
          let x = particle.tx;
          let y = particle.ty;
          let alpha = 1;
          let hoverBoost = 0;

          if (elapsed < settleAt) {
            const local = (elapsed - particle.delay) / particle.duration;
            const progress = local <= 0 ? 0 : local >= 1 ? 1 : easeOut(local);
            x = particle.sx + (particle.tx - particle.sx) * progress;
            y = particle.sy + (particle.ty - particle.sy) * progress;
            alpha = Math.max(0, Math.min(1, local + .14));
          } else {
            x += Math.sin(time * .9 + particle.phase) * .34;
            y += Math.cos(time * .72 + particle.phase) * .42;

            if (pointer.active) {
              const dx = x - pointer.x;
              const dy = y - pointer.y;
              const radius = Math.max(86, Math.min(132, stageWidth * .22));
              const distanceSquared = dx * dx + dy * dy;
              if (distanceSquared < radius * radius) {
                const distance = Math.sqrt(distanceSquared) || 1;
                hoverBoost = 1 - distance / radius;
                const force = hoverBoost * 16;
                x += dx / distance * force;
                y += dy / distance * force;
              }
            }
          }

          if (alpha <= .01) return;
          context.fillStyle = "#030405";
          const size = particle.size * (1 + hoverBoost * .5);
          context.globalAlpha = alpha * .16;
          context.fillRect(x - .35, y - .35, size + .7, size + .7);
          context.globalAlpha = alpha;
          context.fillRect(x, y, size, size);
        });

        context.globalAlpha = 1;
        frameId = window.requestAnimationFrame(draw);
      };

      let resizeTimer = 0;
      window.addEventListener("resize", () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          measure();
          layoutParticles(false);
        }, 150);
      });

      particlePortrait.addEventListener("pointermove", (event) => {
        const rect = particleCanvas.getBoundingClientRect();
        pointer.x = event.clientX - rect.left;
        pointer.y = event.clientY - rect.top;
        pointer.active = true;
      });
      particlePortrait.addEventListener("pointerleave", () => { pointer.active = false; });
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) window.cancelAnimationFrame(frameId);
        else {
          startedAt = performance.now() - (settleAt + 100);
          frameId = window.requestAnimationFrame(draw);
        }
      });

      measure();
      sampleImage();
      particlePortrait.classList.add("particle-ready");
      startedAt = performance.now();
      frameId = window.requestAnimationFrame(draw);
    };

    const scheduleParticleReveal = async () => {
      try { await particleImage.decode(); } catch { /* load event already confirms a usable image */ }
      window.requestAnimationFrame(() => window.requestAnimationFrame(startParticleReveal));
    };

    if (particleImage.complete && particleImage.naturalWidth > 0) void scheduleParticleReveal();
    else particleImage.addEventListener("load", () => { void scheduleParticleReveal(); }, { once: true });
  }
</script>
