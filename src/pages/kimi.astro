---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";

const metrics = [
  { value: "120K+", label: "Study-content views", note: "Distribution" },
  { value: "100+", label: "Student enquiries and needs", note: "Problem discovery" },
  { value: "5 students", label: "Students in the initial trial", note: "In-depth trial" },
  { value: "1 project", label: "Open-source AI study project", note: "Public output" }
];

const workflow = [
  "Real student questions",
  "Structured intake",
  "AI follow-up questions",
  "Initial path triage",
  "Four-week overview",
  "Daily tasks",
  "Evidence from practice",
  "Ongoing adjustments"
];

const systemModules = [
  "Student intake protocol",
  "Input completeness checks",
  "Study paths and priorities",
  "Four-week path and seven-day starter templates",
  "Maths, English, physics and chemistry rules",
  "Daily feedback and adjustments",
  "Human review and risk boundaries",
  "Manual prompts and open-source repository"
];

const capabilities = [
  {
    index: "01",
    title: "Content from real use",
    copy: "Create cases around study, research, websites and open-source work, documenting first successes as well as limitations and failures."
  },
  {
    index: "02",
    title: "First-hand product feedback",
    copy: "Record why people do not use a tool, where first use breaks down and what helps younger users understand it."
  },
  {
    index: "03",
    title: "Reusable adoption cases",
    copy: "Adapt the study workflow to Kimi and document it as open-source work, tutorials, reflections and a map of user questions."
  }
];

const plan = [
  { week: "W01", title: "Migration", copy: "Run the existing AI study workflow with Kimi and document capabilities, limitations and migration effort." },
  { week: "W02", title: "Content", copy: "Produce two or three pieces covering first use, workflows and failures or limitations." },
  { week: "W03", title: "Testing", copy: "Invite a small group of students or younger users to try it and collect recurring questions and feedback." },
  { week: "W04", title: "Delivery", copy: "Deliver a content review, user-question map, product feedback and a public case or demo." }
];
---

<BaseLayout
  title="Kimi Ambassador Application | Ansyn"
  description="Ansyn’s Kimi ambassador application: younger users, AI study workflows, content and first-hand product feedback."
  image="/kimi/og-kimi.png"
>
  <article class="kimi-page">
    <section class="kimi-hero shell" aria-labelledby="kimi-title">
      <div class="dossier-bar">
        <span>APPLICATION DOSSIER / 2026</span>
        <span class="live-label"><i aria-hidden="true"></i> EVIDENCE-LED</span>
      </div>
      <div class="hero-layout">
        <div class="hero-main">
          <p class="kimi-kicker">Kimi Ambassador Application</p>
          <h1 id="kimi-title"><span>Ansyn</span></h1>
          <p class="role-line">AI product adoption <b>×</b> Content operations <b>×</b> User research</p>
          <p class="hero-intro">
            Starting with real needs, taking AI beyond a single piece of content into
            <mark>usable workflows</mark> and ongoing feedback.
          </p>
          <div class="button-row">
            <a class="button kimi-primary" href="/downloads/安寻_Kimi推广大使作品集.pdf" download>
              Download portfolio PDF <span aria-hidden="true">↓</span>
            </a>
            <a class="button" href="https://github.com/7-an/ai-study-path-triage" target="_blank" rel="noopener noreferrer">
              View open-source project ↗
            </a>
          </div>
        </div>
        <aside class="hero-note" aria-label="Personal introduction">
          <div class="note-index">PROFILE / 001</div>
          <p>
            At 18, just out of high school, I was exploring how AI could help me
            understand users, build workflows and explain complex tools in ways younger people can use.
          </p>
          <dl>
            <div><dt>Status</dt><dd>BUILDING IN PUBLIC</dd></div>
            <div><dt>Starting point</dt><dd>Real problems</dd></div>
            <div><dt>Method</dt><dd>Action → Evidence → Adjustment</dd></div>
          </dl>
        </aside>
      </div>
      <div class="hero-index">
        <span>REAL USERS</span><i aria-hidden="true">→</i>
        <span>REAL WORKFLOWS</span><i aria-hidden="true">→</i>
        <span>REAL FEEDBACK</span>
      </div>
    </section>

    <section class="metric-section shell" aria-label="Key figures">
      {metrics.map((metric, index) => (
        <article class="metric-card">
          <span class="metric-index">0{index + 1} / {metric.note}</span>
          <strong>{metric.value}</strong>
          <p>{metric.label}</p>
        </article>
      ))}
      <p class="data-note">
        DATA SNAPSHOT / 2026.07 / Views and enquiries from content analytics and direct conversations; 81 user questions have been structured and archived.
      </p>
    </section>

    <section class="case-section shell" id="project">
      <header class="case-heading">
        <div>
          <p class="kimi-kicker">CASE 01 / CORE PROJECT</p>
          <h2>From 100+ student enquiries<br />to an open-source AI study workflow</h2>
        </div>
        <p>
          Students kept asking where to start, how to identify gaps and how to balance online lessons with practice,
          and how to make AI part of their study routine.
        </p>
      </header>

      <div class="case-grid">
        <div class="case-story">
          <section class="case-copy">
            <span class="case-label">01 / WHERE IT STARTED</span>
            <p>
              One post on high school study systems reached over 120,000 views. I then identified recurring questions in comments and messages,
              structured 81 complete records and recruited five students for the initial in-depth trial.
            </p>
          </section>
          <section class="case-copy">
            <span class="case-label">02 / WHAT I DID</span>
            <ul>
              <li>Anonymised comments, messages and follow-up feedback</li>
              <li>Designed structured intake and follow-up questions</li>
              <li>Used AI to draft four-week paths and seven-day starter plans</li>
              <li>Reviewed each plan manually, recording edits and errors</li>
              <li>Collected daily evidence and adjusted the next step</li>
              <li>Open-sourced rules, prompts, templates and anonymised cases</li>
            </ul>
          </section>
        </div>
        <figure class="project-cover">
          <img src="/kimi/study-path-workflow.png" alt="Concept illustration of the AI study workflow experiment" width="1672" height="941" loading="lazy" />
          <figcaption>
            <span>AI STUDY PATH TRIAGE / WORKFLOW CONCEPT</span>
            <a href="https://github.com/7-an/ai-study-path-triage" target="_blank" rel="noopener noreferrer">GITHUB ↗</a>
          </figcaption>
        </figure>
      </div>

      <div class="workflow-panel" aria-label="Project workflow">
        <div class="workflow-head">
          <span>FROM QUESTION TO CORRECTION</span>
          <span>8 STEPS</span>
        </div>
        <ol>
          {workflow.map((step, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{step}</strong>
            </li>
          ))}
        </ol>
      </div>

      <div class="module-grid">
        <div class="module-intro">
          <p class="kimi-kicker">SYSTEM / WHAT SHIPPED</p>
          <h3>What the project includes</h3>
          <p>A working structure with input checks, human judgement and feedback-based adjustments, beyond a single prompt.</p>
        </div>
        <ul>
          {systemModules.map((item, index) => (
            <li><span>{String(index + 1).padStart(2, "0")}</span>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="evidence-section">
      <div class="shell">
        <header class="evidence-heading">
          <p class="kimi-kicker">EVIDENCE / NOT A DEMO</p>
          <h2>Plans need to meet real life.</h2>
          <p>I retain anonymised feedback on time spent, friction, unfinished tasks and decisions needing human judgement, alongside successful outputs.</p>
        </header>
        <div class="evidence-grid">
          <figure class="feedback-figure">
            <div class="feedback-window">
              <img src="/kimi/evidence-feedback.png" alt="Anonymised study feedback from five students" width="1200" height="5474" loading="lazy" />
            </div>
            <figcaption>First-day feedback from five students / Names and aliases redacted</figcaption>
          </figure>
          <div class="evidence-side">
            <figure>
              <img src="/kimi/evidence-chat.png" alt="An anonymised study chat discussing Kimi" width="1537" height="1023" loading="lazy" />
              <figcaption>Study group conversations / Problems with tools and plans during use</figcaption>
            </figure>
            <div class="findings">
              <p class="kimi-kicker">THREE FINDINGS</p>
              <blockquote>Generating a plan is the easy part. Getting enough reliable information is harder.</blockquote>
              <blockquote>Personalisation means changing the next step based on what happened in practice.</blockquote>
              <blockquote>The system must know when to stop automated judgement and ask a person for help.</blockquote>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="growth-section shell">
      <header class="section-split">
        <div>
          <p class="kimi-kicker">CASE 02 / CONTENT → RESEARCH</p>
          <h2>How a post<br />becomes user research</h2>
        </div>
        <p>
          The aim is to connect content reach with real users, questions and product feedback.
        </p>
      </header>
      <div class="funnel" aria-label="From content to product feedback">
        <div><span>01 / REACH</span><strong>120K+</strong><p>Study-content views</p></div>
        <i aria-hidden="true">→</i>
        <div><span>02 / QUESTIONS</span><strong>100+</strong><p>Student enquiries and needs</p></div>
        <i aria-hidden="true">→</i>
        <div><span>03 / TEST</span><strong>5 students</strong><p>Students in the initial trial</p></div>
        <i aria-hidden="true">→</i>
        <div><span>04 / OUTPUT</span><strong>Open source</strong><p>Workflow and anonymised cases</p></div>
      </div>
      <div class="growth-note">
        <p>Content is a starting point.</p>
        <strong>Reach → Comments → Enquiries → Cases → Trials → Adjustments</strong>
        <a href="https://www.douyin.com/article/7661876024908507762" target="_blank" rel="noopener noreferrer">View the original post ↗</a>
      </div>
    </section>

    <section class="lab-section">
      <div class="shell lab-grid">
        <div class="lab-copy">
          <p class="kimi-kicker">CASE 03 / AI-COLLABORATIVE BUILD</p>
          <h2>Ansyn Lab</h2>
          <p class="lab-lead">A personal home on the web, built with AI</p>
          <p>
            With AI and Codex, I worked through requirements, structure, code, visual feedback and revisions,
            then launched a personal website for writing, projects and exploration.
          </p>
          <ul>
            <li>Defined requirements, structure and content hierarchy</li>
            <li>Built, debugged and iterated with AI</li>
            <li>Refined visuals and interaction through feedback</li>
            <li>Launched a lasting home for the work</li>
          </ul>
          <a class="button kimi-primary" href="/" target="_blank">Visit Ansyn Lab ↗</a>
        </div>
        <figure class="lab-preview">
          <img src="/kimi/ansyn-lab-preview.png" alt="Ansyn Lab website preview" width="1729" height="910" loading="lazy" />
          <figcaption>Taking an uncertain idea through to something people can use.</figcaption>
        </figure>
      </div>
    </section>

    <section class="contribution-section shell" id="contribution">
      <header class="section-split">
        <div>
          <p class="kimi-kicker">WHY KIMI / CONTRIBUTION</p>
          <h2>What I could contribute to Kimi</h2>
        </div>
        <p>
          Use real projects to investigate what Kimi can help a specific group of users do,
          then bring usage observations and first-hand feedback back to the team.
        </p>
      </header>
      <div class="capability-grid">
        {capabilities.map((item) => (
          <article>
            <span>{item.index}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="plan-section">
      <div class="shell">
        <header class="plan-heading">
          <div>
            <p class="kimi-kicker">FIRST 30 DAYS / ACTION PLAN</p>
            <h2>Start with a real trial we can learn from.</h2>
          </div>
          <p>Commit to the work, without promising reach I cannot control.</p>
        </header>
        <ol class="plan-grid">
          {plan.map((item) => (
            <li>
              <span>{item.week}</span>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </li>
          ))}
        </ol>
        <div class="deliverables">
          <span>DELIVERABLES</span>
          <strong>Content review</strong>
          <strong>User-question map</strong>
          <strong>Product feedback</strong>
          <strong>Public case / demo</strong>
        </div>
      </div>
    </section>

    <section class="download-section shell">
      <div>
        <p class="kimi-kicker">APPLICATION PACKAGE</p>
        <h2>An overview in 30 seconds.<br />Evidence if you want to go deeper.</h2>
      </div>
      <div class="download-list">
        <a href="/downloads/安寻_Kimi推广大使作品集.pdf" download>
          <span><b>01</b> 7-page portfolio PDF</span><strong>Download ↓</strong>
        </a>
        <a href="/downloads/安寻_个人简历.pdf" download>
          <span><b>02</b> 1-page CV PDF</span><strong>Download ↓</strong>
        </a>
        <a href="/downloads/安寻_Ansyn_Kimi推广大使申请作品集.pdf" download>
          <span><b>03</b> Portfolio and CV in one PDF</span><strong>Download ↓</strong>
        </a>
        <a href="https://github.com/7-an/ai-study-path-triage" target="_blank" rel="noopener noreferrer">
          <span><b>04</b> AI Study Path Triage</span><strong>GitHub ↗</strong>
        </a>
        <a href={siteConfig.social.x} target="_blank" rel="noopener noreferrer">
          <span><b>05</b> Public experiment notes</span><strong>X ↗</strong>
        </a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .kimi-page {
    --kimi-highlight: #dddddd;
    --kimi-highlight-soft: var(--paper-deep);
    --kimi-paper: var(--paper);
    --kimi-ink: var(--ink);
    --kimi-muted: var(--muted);
    overflow: hidden;
    background: var(--kimi-paper);
  }

  .kimi-kicker {
    margin: 0 0 18px;
    color: var(--kimi-muted);
    font: 700 .72rem/1.4 var(--mono);
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .kimi-hero {
    min-height: calc(100svh - 72px);
    display: flex;
    flex-direction: column;
    border-inline: 1px solid var(--kimi-ink);
  }

  .dossier-bar,
  .workflow-head {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 13px 18px;
    border-bottom: 1px solid var(--kimi-ink);
    font: 700 .68rem var(--mono);
    letter-spacing: .09em;
  }

  .live-label {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .live-label i {
    width: 8px;
    height: 8px;
    background: var(--kimi-highlight);
    border: 1px solid var(--kimi-ink);
    border-radius: 50%;
  }

  .hero-layout {
    flex: 1;
    display: grid;
    grid-template-columns: 1.65fr .7fr;
  }

  .hero-main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(58px, 8vw, 112px) 6%;
    border-right: 1px solid var(--kimi-ink);
  }

  .hero-main h1 {
    display: flex;
    align-items: baseline;
    gap: .15em;
    margin: 0;
    font-size: clamp(5rem, 10vw, 9.4rem);
    line-height: .8;
    letter-spacing: -.09em;
  }

  .hero-main h1 span {
    font-size: .42em;
    letter-spacing: -.05em;
  }

  .role-line {
    margin: 35px 0 0;
    font-size: clamp(1.1rem, 2vw, 1.55rem);
    font-weight: 800;
    letter-spacing: -.03em;
  }

  .role-line b {
    padding-inline: .25em;
    color: var(--kimi-muted);
  }

  .hero-intro {
    max-width: 760px;
    margin: 32px 0 0;
    font-size: clamp(1.45rem, 2.8vw, 2.35rem);
    line-height: 1.4;
    font-weight: 720;
    letter-spacing: -.045em;
    text-wrap: balance;
  }

  .hero-intro mark {
    background: linear-gradient(transparent 58%, var(--kimi-highlight) 58%);
  }

  .kimi-primary {
    background: var(--kimi-highlight);
  }

  .hero-note {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 34px;
    background: var(--kimi-ink);
    color: var(--kimi-paper);
  }

  .note-index {
    margin-bottom: auto;
    padding-bottom: 16px;
    border-bottom: 1px solid #494949;
    color: #aaaaaa;
    font: .68rem var(--mono);
  }

  .hero-note > p {
    margin: 70px 0 35px;
    font-size: 1.05rem;
  }

  .hero-note dl,
  .hero-note dd {
    margin: 0;
  }

  .hero-note dl div {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 18px;
    padding: 11px 0;
    border-top: 1px solid #494949;
    font: .7rem var(--mono);
  }

  .hero-note dt {
    color: #9c9c9c;
  }

  .hero-note dd {
    color: var(--kimi-highlight);
  }

  .hero-index {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 17px 22px;
    border-top: 1px solid var(--kimi-ink);
    background: var(--kimi-highlight);
    font: 800 .75rem var(--mono);
    letter-spacing: .07em;
  }

  .metric-section {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-inline: 1px solid var(--kimi-ink);
    border-bottom: 1px solid var(--kimi-ink);
  }

  .metric-card {
    min-height: 250px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px;
    border-right: 1px solid var(--kimi-ink);
  }

  .metric-card:nth-child(4) {
    border-right: 0;
  }

  .metric-index {
    margin-bottom: auto;
    color: var(--kimi-muted);
    font: .65rem var(--mono);
    text-transform: uppercase;
  }

  .metric-card strong {
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: .9;
    letter-spacing: -.075em;
  }

  .metric-card p {
    margin: 14px 0 0;
    font-weight: 750;
  }

  .data-note {
    grid-column: 1 / -1;
    margin: 0;
    padding: 12px 18px;
    border-top: 1px solid var(--kimi-ink);
    color: var(--kimi-muted);
    font: .65rem/1.5 var(--mono);
  }

  .case-section,
  .growth-section,
  .contribution-section,
  .download-section {
    padding-block: 132px;
  }

  .case-heading,
  .section-split {
    display: grid;
    grid-template-columns: 1.35fr .65fr;
    gap: 8%;
    align-items: end;
    padding-bottom: 45px;
    border-bottom: 1px solid var(--kimi-ink);
  }

  .case-heading h2,
  .section-split h2,
  .evidence-heading h2,
  .plan-heading h2,
  .download-section h2 {
    margin: 0;
    font-size: clamp(2.8rem, 5.8vw, 6rem);
    line-height: 1.02;
    letter-spacing: -.075em;
    text-wrap: balance;
  }

  .case-heading > p,
  .section-split > p {
    margin: 0;
    color: var(--kimi-muted);
    font-size: 1.05rem;
  }

  .case-grid {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    border-bottom: 1px solid var(--kimi-ink);
  }

  .case-story {
    border-right: 1px solid var(--kimi-ink);
  }

  .case-copy {
    padding: 34px;
    border-bottom: 1px solid var(--kimi-ink);
  }

  .case-copy:last-child {
    border-bottom: 0;
  }

  .case-label {
    color: var(--kimi-muted);
    font: .7rem var(--mono);
  }

  .case-copy p {
    margin: 52px 0 0;
    font-size: 1.13rem;
  }

  .case-copy ul,
  .lab-copy ul {
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }

  .case-copy li,
  .lab-copy li {
    padding: 11px 0 11px 21px;
    border-top: 1px solid var(--line);
    position: relative;
  }

  .case-copy li::before,
  .lab-copy li::before {
    content: "↳";
    position: absolute;
    left: 0;
    color: var(--accent-strong);
  }

  .project-cover {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 34px;
    background: var(--paper-deep);
  }

  .project-cover img {
    width: 100%;
    height: 100%;
    min-height: 440px;
    object-fit: cover;
    border: 1px solid var(--kimi-ink);
    filter: saturate(.85);
  }

  .project-cover figcaption,
  .feedback-figure figcaption,
  .evidence-side figcaption,
  .lab-preview figcaption {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-top: 13px;
    font: .65rem/1.5 var(--mono);
  }

  .workflow-panel {
    margin-top: 70px;
    border: 1px solid var(--kimi-ink);
  }

  .workflow-head {
    background: var(--kimi-ink);
    color: var(--kimi-paper);
  }

  .workflow-panel ol {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .workflow-panel li {
    min-height: 160px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
    border-right: 1px solid var(--kimi-ink);
    border-bottom: 1px solid var(--kimi-ink);
  }

  .workflow-panel li:nth-child(4n) {
    border-right: 0;
  }

  .workflow-panel li:nth-child(n + 5) {
    border-bottom: 0;
  }

  .workflow-panel li span {
    color: var(--kimi-muted);
    font: .7rem var(--mono);
  }

  .workflow-panel li strong {
    font-size: 1rem;
  }

  .workflow-panel li:nth-child(5) {
    background: var(--kimi-highlight);
  }

  .module-grid {
    display: grid;
    grid-template-columns: .75fr 1.25fr;
    margin-top: 70px;
    border-top: 1px solid var(--kimi-ink);
    border-bottom: 1px solid var(--kimi-ink);
  }

  .module-intro {
    padding: 40px 34px;
    border-right: 1px solid var(--kimi-ink);
  }

  .module-intro h3 {
    margin: 0;
    font-size: 2.1rem;
    letter-spacing: -.05em;
  }

  .module-intro > p:last-child {
    margin: 30px 0 0;
    color: var(--kimi-muted);
  }

  .module-grid ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .module-grid li {
    padding: 23px;
    border-right: 1px solid var(--kimi-ink);
    border-bottom: 1px solid var(--kimi-ink);
    font-weight: 700;
  }

  .module-grid li:nth-child(even) {
    border-right: 0;
  }

