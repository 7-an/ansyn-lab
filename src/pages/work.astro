---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectRows from "../components/ProjectRows.astro";
import { featuredProjects as features, communityProjects } from "../config/projects";




---

<BaseLayout
  title="Work & projects | Ansyn Lab"
  description="Projects by Ansyn: VOIDTYPE, Video Subtitle Extractor, AI Study Path Triage, Ansyn Lab and ongoing collaborations at KOSX.ai."
>
  <section class="page-hero-min shell" aria-labelledby="work-title">
    <div class="hero-intro" lang="en" data-reveal>
      <h1 id="work-title">Making things.<br />Figuring things out.</h1>
      <p>Websites, tools and experiments with AI. Some are live, others are still taking shape. Each one starts with a question and gets better through use.</p>
    </div>
    <p class="hero-foot" data-reveal data-reveal-delay="1">
      <span>SELECTED WORK / PROJECTS & EXPERIMENTS</span>
      <span>2026 ~ now</span>
    </p>
  </section>

  <section class="showcase" aria-label="Selected projects">
    <ProjectRows projects={[...features, ...communityProjects]} />
  </section>

</BaseLayout>

<style>
  .page-hero-min {
    display: flex;
    padding-top: clamp(160px, 25vh, 280px);
    padding-bottom: 0;
    flex-direction: column;
  }

  .hero-intro {
    width: 100%;
    margin: 0;
    padding-left: 37.5%;
  }

  .hero-intro h1 {
    margin: 0;
    font-size: clamp(3.2rem, 5vw, 5.6rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -.05em;
  }

  .hero-intro p {
    max-width: 320px;
    margin: 16px 0 0;
    color: var(--muted);
    font-size: .95rem;
    line-height: 1.75;
  }

  .hero-foot {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin: 24px 0 0;
    font-family: var(--mono);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .hero-foot span:last-child {
    color: var(--muted);
    font-weight: 400;
    white-space: nowrap;
    text-transform: none;
  }

  @media (max-width: 700px) {
    .page-hero-min {
      min-height: 0;
      padding-top: 84px;
    }
    .hero-intro {
      width: 100%;
      margin: 0;
      padding-left: 0;
    }
    .hero-intro h1 { font-size: clamp(2rem, 11vw, 3.8rem); }
    .hero-foot { flex-direction: column; gap: 10px; margin-top: 48px; }
  }

</style>
