---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { externalWriting, platformLabels } from "../../data/external-writing";
const categories = [...new Set(externalWriting.map((article) => article.category))];
---

<BaseLayout title="Writing | Ansyn Lab" description="An open notebook on AI, personal experiments and the real world. Writing and reflections by Ansyn.">
  <div class="writing-page" data-writing>
    <header class="writing-hero writing-shell">
      <p class="writing-kicker" lang="en">Writing & field notes</p>
      <h1 lang="en">Notes from<br />the real world.</h1>
      <div class="writing-intro">
        <p>Things I’ve tried. Questions I’m working through.<br />Notes on AI, personal experiments and life beyond school.</p>
        <span lang="en">An open notebook.<br />Still figuring things out.</span>
      </div>
    </header>

    <section class="writing-archive writing-shell" aria-label="Writing archive">
      <div class="writing-tools">
        <div class="writing-platforms" role="group" aria-label="Filter by platform">
          <button type="button" data-writing-platform="all" aria-pressed="true">All <span>{String(externalWriting.length).padStart(2, "0")}</span></button>
          <button type="button" data-writing-platform="X" aria-pressed="false">X</button>
          <button type="button" data-writing-platform="Douyin" aria-pressed="false">Douyin</button>
        </div>
        <label class="writing-category"><span class="writing-sr-only">Filter by topic</span><select data-writing-category><option value="all">All topics</option>{categories.map(category => <option value={category}>{category}</option>)}</select></label>
      </div>
      <div class="writing-columns">
        <div class="writing-index">
          <div class="writing-index-label"><span lang="en">Index</span><span role="status" data-writing-count>{externalWriting.length} entries</span></div>
          <div class="writing-entries">
            {externalWriting.map((article, index) => {
              const Tag = article.externalUrl ? "a" : "article";
              return <Tag class:list={["writing-entry", { "is-pending": !article.externalUrl }]} data-writing-entry={index} data-platform={article.platform} data-category={article.category} href={article.externalUrl || undefined} target={article.externalUrl ? "_blank" : undefined} rel={article.externalUrl ? "noopener noreferrer" : undefined}>
                <span class="writing-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <div class="writing-entry-body">
                  <div class="writing-meta"><span>{article.category}</span>{article.publishDate && <time datetime={article.publishDate}>{article.publishDate.replaceAll("-", ".")}</time>}</div>
                  <h2 lang="zh-CN" data-preserve-language>{article.title}</h2>
                  <p class="writing-summary">{article.description}</p>
                  {article.media && <figure class="writing-inline-media">
                    <img src={article.media.src} alt={article.media.alt} width={article.media.width} height={article.media.height} loading="lazy" decoding="async" />
                    {(article.media.caption || article.media.videoSrc) && <figcaption>{article.media.caption || "Particle interaction excerpt · Watch the original post"}</figcaption>}
                  </figure>}
                  <span class="writing-source">{article.externalUrl ? `Read on ${platformLabels[article.platform]}` : "Original link coming soon"}</span>
                </div>
                {article.externalUrl && <svg class="writing-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.25" /></svg>}
              </Tag>;
            })}
          </div>
          <p class="writing-empty" data-writing-empty hidden>No entries match these filters yet.</p>
          <p class="writing-index-end">Each piece lives where it was first published. Select a title to read the original.</p>
        </div>
        <aside class="writing-preview-rail" aria-label="Writing preview">
          <div class="writing-preview-sticky">
            <p class="writing-preview-hint" lang="en">Between the lines.</p>
            <div class="writing-preview" data-writing-preview inert>
              <div class="writing-preview-meta"><span lang="en">Reading note</span><span data-preview-number>01</span></div>
              {externalWriting.map((article, index) => article.media && <figure class="writing-preview-media" data-preview-media-index={index} hidden>
                <img src={article.media.src} alt={article.media.alt} width={article.media.width} height={article.media.height} loading="lazy" decoding="async" />
                {article.media.videoSrc && <>
                  <video data-video-src={article.media.videoSrc} muted loop playsinline preload="none" aria-label="Six-second VOIDTYPE particle interaction preview" hidden></video>
                  <button class="writing-video-toggle" type="button" data-video-toggle aria-label="Play particle preview">Play ↗</button>
                </>}
                {article.media.caption && <figcaption>{article.media.caption}</figcaption>}
              </figure>)}
              <p class="writing-preview-category" data-preview-category></p>
              <p class="writing-preview-text" data-preview-text></p>
              <div class="writing-preview-foot"><span data-preview-platform></span><span>↗</span></div>
            </div>
          </div>
        </aside>
      </div>
    </section>
  </div>
  <script>
    import { initWriting } from "../../lib/writing";
    initWriting();
  </script>
</BaseLayout>

<style>
  .writing-page { padding-bottom: clamp(88px, 10vw, 160px); }
  .writing-shell { width: 84%; max-width: 1600px; margin-inline: auto; }
  /* Match About’s heading start, accounting for the 16px kicker and its 26px gap. */
  .writing-hero { padding-top: calc(clamp(96px, 12vw, 240px) * 1.33 - 42px); padding-bottom: clamp(56px, 7vw, 100px); }
  .writing-kicker { margin: 0 0 26px; color: #777; font: 400 11px/16px var(--mono); letter-spacing: .06em; text-transform: uppercase; }
  .writing-hero h1 { margin: 0; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: clamp(56px, 7.2vw, 112px); font-weight: 400; letter-spacing: -.055em; line-height: 1.04; }
  .writing-intro { display: flex; justify-content: space-between; gap: 40px; margin-top: 34px; }
  .writing-intro p { margin: 0; font-size: 14px; line-height: 1.9; color: #555; }
  .writing-intro > span { color: #888; font: 400 11px/1.8 var(--mono); align-self: end; }
  .writing-tools { display: flex; justify-content: space-between; gap: 20px; padding-bottom: 24px; border-bottom: 1px solid #d7d7d7; }
  .writing-platforms { display: flex; gap: 26px; align-items: center; }
  .writing-platforms button { position: relative; border: 0; padding: 4px 0; background: none; color: #888; font: inherit; font-size: 13px; cursor: pointer; }
  .writing-platforms button span { margin-left: 4px; font: 10px var(--mono); vertical-align: super; }
  .writing-platforms button[aria-pressed="true"] { color: var(--ink); }
  .writing-platforms button::after { content: ""; position: absolute; left: 0; right: 0; bottom: -3px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform .3s ease; }
  .writing-platforms button[aria-pressed="true"]::after, .writing-platforms button:hover::after { transform: scaleX(1); }
  .writing-category { display: flex; align-items: center; }
  .writing-category select { max-width: 210px; padding: 6px 20px 6px 0; border: 0; border-radius: 0; color: #666; background: transparent; font: inherit; font-size: 12px; cursor: pointer; }
  .writing-columns { display: grid; grid-template-columns: minmax(0, 1fr); }
  .writing-index-label { display: flex; justify-content: space-between; padding: 22px 0 14px; color: #888; font: 10px var(--mono); text-transform: uppercase; letter-spacing: .04em; }
  .writing-entry { position: relative; display: grid; grid-template-columns: 32px minmax(0, 1fr) 24px; gap: 18px; padding: 30px 0 32px; border-bottom: 1px solid #dedede; color: var(--ink); }
  .writing-entry[hidden] { display: none; }
  .writing-number { padding-top: 2px; color: #999; font: 10px var(--mono); }
  .writing-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 20px; color: #888; font: 10px/1.5 var(--mono); }
  .writing-entry h2 { margin: 14px 0 0; max-width: 26em; font-size: clamp(23px, 2.3vw, 37px); line-height: 1.5; font-weight: 400; letter-spacing: -.045em; text-wrap: pretty; transition: transform .55s cubic-bezier(.16, 1, .3, 1); }
  .writing-summary { max-width: 42em; margin: 16px 0 0; font-size: 13px; line-height: 1.9; color: #777; }
  .writing-source { display: block; margin-top: 16px; color: #888; font: 10px/1.5 var(--mono); }
  .writing-arrow { margin-top: 34px; transition: transform .5s cubic-bezier(.16, 1, .3, 1), color .3s; }
  a.writing-entry:hover h2, a.writing-entry:focus-visible h2 { transform: translateX(5px); }
  a.writing-entry:hover .writing-arrow, a.writing-entry:focus-visible .writing-arrow { transform: translate(3px, -3px); color: var(--accent); }
  .writing-entry:focus-visible, .writing-tools :focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  .writing-entry.is-pending .writing-source { color: #999; }
  .writing-index-end { margin: 28px 0 0; max-width: 36em; color: #888; font-size: 11px; line-height: 1.8; }
  .writing-empty { padding: 56px 0; font-size: 14px; color: #777; }
  .writing-preview-rail { display: none; }
  .writing-inline-media { margin: 22px 0 0; max-width: 420px; }
  .writing-inline-media img { display: block; width: auto; max-width: 100%; height: auto; max-height: 380px; }
  .writing-inline-media figcaption, .writing-preview-media figcaption { margin-top: 10px; color: #777; font-size: 10px; line-height: 1.6; }
  .writing-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (min-width: 760px) and (hover: hover) and (pointer: fine) {
    .writing-columns { grid-template-columns: minmax(0, 1fr) clamp(240px, 28vw, 360px); gap: 5%; }
    .writing-preview-rail { display: block; padding-top: 75px; }
    .writing-preview-sticky { position: sticky; top: clamp(90px, 14vh, 145px); }
    .writing-preview-hint { margin: 0 0 24px; color: #aaa; font: 11px var(--mono); }
    .writing-preview { padding: clamp(24px, 2.5vw, 40px); background: #f0f0f0; border: 1px solid #e8e8e8; opacity: 0; transform: translateY(18px) rotate(1deg); transition: opacity .35s ease, transform .65s cubic-bezier(.16, 1, .3, 1); }
    .writing-inline-media { display: none; }
    .writing-preview-media { position: relative; margin: 24px 0 0; }
    .writing-preview-media[hidden] { display: none; }
    .writing-preview-media img { display: block; width: auto; max-width: 100%; height: auto; max-height: min(34vh, 340px); margin-inline: auto; }
    .writing-preview-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: #000; }
    .writing-preview-media video[hidden] { display: none; }
    .writing-video-toggle { position: absolute; bottom: 8px; right: 8px; padding: 6px 8px; border: 1px solid #555; background: #111d; color: #fff; font: 10px var(--mono); cursor: pointer; }
    .writing-video-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    .writing-preview.has-media .writing-preview-text { font-size: 13px; line-height: 1.8; }
    .writing-preview.has-media .writing-preview-category { margin-top: 20px; margin-bottom: 12px; }
    .writing-preview.has-media .writing-preview-foot { margin-top: 20px; }
    .writing-preview.is-visible { opacity: 1; transform: translateY(0) rotate(-.6deg); }
    .writing-preview-meta, .writing-preview-foot { display: flex; justify-content: space-between; gap: 20px; font: 10px/1.5 var(--mono); color: #888; }
    .writing-preview-meta { padding-bottom: 20px; border-bottom: 1px solid #d4d4d4; text-transform: uppercase; }
    .writing-preview-category { margin: 28px 0 16px; font: 10px/1.5 var(--mono); color: #888; }
    .writing-preview-text { margin: 0; font-size: clamp(16px, 1.4vw, 22px); line-height: 1.85; letter-spacing: -.025em; }
    .writing-preview-foot { margin-top: 32px; }
    [data-writing-enhanced] .writing-summary { position: absolute; width: 1px; height: 1px; padding: 0; margin: 0; overflow: hidden; clip-path: inset(50%); }
  }
  @media (max-width: 600px) {
    .writing-shell { width: auto; margin-inline: 24px; }
    .writing-hero { padding-top: 123px; padding-bottom: 52px; }
    .writing-hero h1 { font-size: clamp(43px, 11.7vw, 68px); }
    .writing-intro { margin-top: 26px; }
    .writing-intro p { font-size: 12px; }
    .writing-intro > span { display: none; }
    .writing-entry { grid-template-columns: 20px minmax(0, 1fr) 18px; gap: 10px; padding-block: 26px; }
    .writing-entry h2 { font-size: 22px; }
    .writing-meta { font-size: 9px; }
    .writing-arrow { width: 18px; }
    .writing-platforms { gap: 18px; }
    .writing-category select { max-width: 140px; font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .writing-page *, .writing-page *::after { transition: none !important; }
    .writing-preview, .writing-preview.is-visible, a.writing-entry:hover h2, a.writing-entry:focus-visible h2, a.writing-entry:hover .writing-arrow, a.writing-entry:focus-visible .writing-arrow { transform: none; }
  }
</style>
