---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("writing", ({ data, id }) => !data.draft && id !== "_template");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const rawBody = entry.body ?? "";
const chineseCharacters = (rawBody.match(/[\u4e00-\u9fff]/g) ?? []).length;
const latinWords = (rawBody.match(/[A-Za-z0-9]+/g) ?? []).length;
const readingMinutes = Math.max(1, Math.ceil((chineseCharacters + latinWords) / 350));
const formattedDate = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric"
}).format(entry.data.publishDate);
---

<BaseLayout
  title={`${entry.data.title}｜Ansyn Lab`}
  description={entry.data.description}
  type="article"
  publishDate={entry.data.publishDate}
>
  <article class="post shell">
    <header class="post-header">
      <a class="back-link" href="/writing/">← 返回文章列表</a>
      <div class="article-meta">
        <span class="platform-badge">站内文章</span>
        <span>{entry.data.category}</span>
        <span>{formattedDate}</span>
      </div>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <div class="post-detail">
        <span>预计阅读 {readingMinutes} 分钟</span>
        {entry.data.updatedDate && <span>更新于 {entry.data.updatedDate.toLocaleDateString("zh-CN")}</span>}
      </div>
      <ul class="tag-list" aria-label="文章标签">
        {entry.data.tags.map((tag) => <li>#{tag}</li>)}
      </ul>
    </header>
    <div class="post-layout">
      <aside class="post-aside" aria-hidden="true">
        <span>ANSYN LAB</span>
        <span>PUBLIC NOTE</span>
        <span>BUILDING IN PUBLIC</span>
      </aside>
      <div class="prose"><Content /></div>
    </div>
    <footer class="post-footer">
      <p>这不是最终答案，只是此刻的行动记录。</p>
      <a class="button" href="/writing/">继续阅读其他笔记 →</a>
    </footer>
  </article>
</BaseLayout>
